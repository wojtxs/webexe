{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@modules/*": ["src/modules/*"],
      "@styles/*": ["src/styles/*"],
      "@gl/*": ["src/gl/*"],
      "@components/*": ["src/components/*"]
    }
  },
  "include": ["src", "scripts"]
}
