---
/**
 * /lab/hero — prototyp hero „Okno ze słowem” (tylko dev).
 * Mechanika z alpanet.pl (karta na środku ze słowem wtopionym w obraz, scroll rozszerza ją do pełnej
 * sceny) i z chipsa.design (mały nagłówek w rogu, jeden bohater, dużo powietrza). Słowa to warstwy
 * oferty z BRIEF (te same co w loaderze), w oknie żywa realizacja z tej warstwy.
 * Słowo stoi w dwóch kopiach: ciemna na Pianie pod kartą, jasna w karcie. Karta przycina jasną,
 * więc w oknie słowo jest białe na aplikacji, a poza oknem ciemne.
 */
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Loader from '../../components/Loader.astro';
import Grid from '../../components/Grid.astro';
import CaseShot from '../../components/CaseShot.astro';
import Tags from '../../components/Tags.astro';
import Manifest from '../../sections/Manifest.astro';
import { caseHref, getRealizacje, morphName } from '../../data/realizacje';
import { layers } from '../../data/layers';
import { noOrphans } from '../../data/typo';
import '../../styles/lab/hero-words.css';

const isDev = import.meta.env.DEV;
const all = await getRealizacje();
const pick = (live: string) => all.find((entry) => entry.data.live === live)!;
// Warstwa oferty → realizacja, która ją pokazuje. light: w środku kadru jasny interfejs, karta
// przyciemnia go Głębią, żeby jasne słowo było czytelne, a okno odcinało się od Piany
const slots = [
  { word: layers[0], entry: pick('flota'), light: false },
  { word: layers[1], entry: pick('przeplywy'), light: false },
  { word: layers[2], entry: pick('faktury'), light: true },
  { word: layers[3], entry: pick('serwis'), light: true },
];
const pad = (n: number) => String(n).padStart(2, '0');
const chars = (word: string) => [...word.toUpperCase()];
---

{isDev ? (
  <Base title="Lab — hero" noindex={true}>
    <Loader slot="chrome" />
    <Header slot="chrome" />
    <section
      id="hero"
      class="hw theme-light sticky-track"
      data-nav-theme="light"
      data-module="card-expand hero-words"
      data-card-expand-leave
      aria-labelledby="hero-title"
    >
      <Grid nodes={false} />
      <div class="sticky-item hw__stage">
        <div class="container hw__top">
          <h1 id="hero-title" class="hw__title" data-card-expand="fade">
            <!-- prettier-ignore -->
            <span data-split="words" data-split-intro>Budujemy oprogramowanie dla firm <br class="br-d" />i zostajemy przy nim na lata<span class="hw__stop">.</span></span>
          </h1>
          <div class="hw__lead-box" data-card-expand="fade">
            <p class="hw__lead" data-intro>
              {noOrphans(
                'Tworzymy aplikacje do codziennej pracy, łączymy istniejące systemy i automatyzujemy powtarzalne zadania. Zajmujemy się całym projektem — od ustalenia, co trzeba zrobić, po wdrożenie, serwery i późniejszy rozwój.'
              )}
            </p>
          </div>
        </div>

        <!-- Słowo na Pianie (pod kartą) -->
        <!-- Gaśnie przy rozszerzaniu (card-expand fade): po wyjściu karty nie zostaje nad Manifestem -->
        <p class="hw__word hw__word--dark" aria-hidden="true" data-hw-word data-card-expand="fade">
          {slots.map((slot, i) => (
            <span class:list={['hw__item', { 'is-active': i === 0 }]} data-hw-item>
              {chars(slot.word).map((c) => (
                <span class="hw__char" data-hw-char>
                  {c}
                </span>
              ))}
            </span>
          ))}
        </p>

        <div class="hw__window" data-card-expand="window" aria-hidden="true" />

        <!-- TODO(treść): etykieta kursora, opis figury -->
        <figure class="hw__card" data-card-expand="card" data-cursor="Zobacz realizację">
          <div class="hw__screen" data-hw-screen>
            {slots.map(({ entry, light }, i) => (
              <a
                class:list={[
                  'shot',
                  'hw__shot',
                  { 'is-active': i === 0, 'hw__shot--light': light },
                ]}
                href={caseHref(entry)}
                tabindex="-1"
                aria-hidden="true"
                data-hw-shot
                data-morph={morphName(entry)}
                data-morph-source={morphName(entry)}
              >
                <CaseShot
                  image={entry.data.cover}
                  alt=""
                  live={entry.data.live}
                  uid={`hw-${entry.id}`}
                  sizes="(max-width: 991px) 150vh, 100vw"
                  eager={i === 0}
                />
              </a>
            ))}
            <!-- To samo słowo w karcie: widać je tylko w oknie -->
            <p class="hw__word hw__word--light" aria-hidden="true" data-hw-word>
              {slots.map((slot, i) => (
                <span class:list={['hw__item', { 'is-active': i === 0 }]} data-hw-item>
                  {chars(slot.word).map((c) => (
                    <span class="hw__char" data-hw-char>
                      {c}
                    </span>
                  ))}
                </span>
              ))}
            </p>
          </div>
          <figcaption class="sr-only">
            Wybrane realizacje webexe: {slots.map((s) => s.entry.data.title).join(', ')}
          </figcaption>
        </figure>

        <!-- TODO(treść): etykiety pokazu i pauzy -->
        <div class="container hw__bottom">
          <div class="hw__meta-box" data-card-expand="fade">
            <div class="hw__meta" data-intro>
              <p class="hw__count t-label" aria-hidden="true">
                <span data-hw-count>01</span> / {pad(slots.length)}
              </p>
              <div class="hw__metas">
                {slots.map(({ entry }, i) => (
                  <div class:list={['hw__meta-item', { 'is-active': i === 0 }]} data-hw-meta>
                    <a class="hw__meta-link" href={caseHref(entry)} data-morph={morphName(entry)}>
                      {noOrphans(entry.data.title)}
                    </a>
                    <Tags tags={entry.data.tags} class="hw__tags" />
                  </div>
                ))}
              </div>
            </div>
          </div>
          <div class="hw__pause-box" data-card-expand="fade">
            <button
              class="hw__pause"
              type="button"
              aria-pressed="false"
              aria-label="Zatrzymaj pokaz realizacji"
              data-hw-pause
              data-intro
            >
              <span class="hw__pause-icon" aria-hidden="true" />
            </button>
          </div>
        </div>
      </div>
    </section>
    <Manifest />
  </Base>
) : (
  <p>Strona niedostępna.</p>
)}
