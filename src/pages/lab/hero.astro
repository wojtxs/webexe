---
// /lab/hero — spike F2 maski hero (tylko dev, noindex). Strojenie: /lab/hero?debug
import Base from '../../layouts/Base.astro';

const isDev = import.meta.env.DEV;
---

{isDev ? (
  <Base title="Lab: hero spike — webexe" noindex={true}>
    <section class="spike container" data-module="hero-spike">
      <div class="spike-copy">
        <h1 class="spike-title">
          Budujemy
          <br />
          oprogramowanie
          <br />
          dla firm i zostajemy
          <br />
          przy nim na lata.
        </h1>
        <p class="spike-lead">
          Aplikacje webowe, systemy wewnętrzne, integracje i automatyzacje z AI. Projektujemy je
          razem z wami, wdrażamy etapami i utrzymujemy na własnej infrastrukturze.
        </p>
        <p class="spike-hint">
          Tekstury zastępcze. Panel strojenia: <a href="?debug">?debug</a>
        </p>
        <p class="spike-fallback">Brak WebGL: spike wymaga WebGL2.</p>
      </div>
      <div class="spike-visual" data-gl="hero" aria-hidden="true" />
    </section>
    <section class="spike-after" aria-label="Miejsce na scroll">
      <p class="spike-hint">Przewiń: płaszczyzna hero trzyma się elementu DOM.</p>
    </section>
  </Base>
) : (
  <html lang="pl">
    <head>
      <meta charset="UTF-8" />
      <title>404</title>
    </head>
    <body>
      <p>Strona niedostępna.</p>
    </body>
  </html>
)}

<style>
  .spike {
    min-height: 100vh;
    align-items: center;
    row-gap: var(--s-8);
  }

  .spike-copy {
    grid-column: 1 / 8;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .spike-title {
    font-size: var(--t-h1);
    font-weight: var(--w-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--ls-h1);
  }

  .spike-lead {
    font-size: var(--t-lead);
    font-weight: var(--w-lead);
    line-height: var(--lh-lead);
    color: var(--c-ink-muted);
    max-width: 38ch;
  }

  .spike-hint {
    font-size: var(--t-small);
    color: var(--c-ink-muted);
  }

  .spike-fallback {
    display: none;
    font-size: var(--t-small);
  }

  [data-gl-fallback] .spike-fallback {
    display: block;
  }

  .spike-visual {
    grid-column: 8 / 13;
    height: 84vh;
  }

  .spike-after {
    min-height: 100vh;
    padding: var(--s-16) var(--grid-padding);
  }

  @media (max-width: 991px) {
    .spike {
      align-content: start;
      padding-top: var(--s-8);
    }

    .spike-copy,
    .spike-visual {
      grid-column: 1 / -1;
    }

    .spike-visual {
      order: -1;
      height: 50vh;
    }
  }

  @media (max-width: 767px) {
    .spike-visual {
      height: 36vh;
    }
  }
</style>
