---
// /lab/hero-x — spike hero z wielkim znakiem x w 3D (tylko dev, noindex). Strojenie: ?debug
import Base from '../../layouts/Base.astro';

const isDev = import.meta.env.DEV;
---

{isDev ? (
  <Base title="Lab: hero x — webexe" noindex={true}>
    <section class="hx" data-module="hero-x">
      <div class="hx-visual" data-gl="hero" aria-hidden="true" />
      <div class="hx-copy container">
        <div class="hx-text">
          <h1 class="hx-title">
            Budujemy
            <br />
            oprogramowanie
            <br />
            dla firm i zostajemy
            <br />
            przy nim na lata.
          </h1>
          <p class="hx-lead">
            Aplikacje webowe, systemy wewnętrzne, integracje i automatyzacje z AI. Projektujemy je
            razem z wami, wdrażamy etapami i utrzymujemy na własnej infrastrukturze.
          </p>
          <p class="hx-hint">
            Ruszaj kursorem po znaku. Panel strojenia: <a href="?debug">?debug</a>
          </p>
          <p class="hx-fallback">Brak WebGL: spike wymaga WebGL2.</p>
        </div>
      </div>
    </section>
    <section class="hx-after" aria-label="Miejsce na scroll">
      <p class="hx-hint">Przewiń: znak jedzie razem z sekcją.</p>
    </section>
  </Base>
) : (
  <html lang="pl">
    <head>
      <meta charset="UTF-8" />
      <title>404</title>
    </head>
    <body>
      <p>Strona niedostępna.</p>
    </body>
  </html>
)}

<style>
  .hx {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .hx-visual {
    position: absolute;
    inset: 0;
    touch-action: pan-y;
  }

  .hx-copy {
    position: relative;
    pointer-events: none;
  }

  .hx-text {
    grid-column: 1 / 7;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .hx-text a {
    pointer-events: auto;
  }

  .hx-title {
    font-size: var(--t-h1);
    font-weight: var(--w-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--ls-h1);
  }

  .hx-lead {
    font-size: var(--t-lead);
    font-weight: var(--w-lead);
    line-height: var(--lh-lead);
    color: var(--c-ink-muted);
    max-width: 38ch;
  }

  .hx-hint {
    font-size: var(--t-small);
    color: var(--c-ink-muted);
  }

  .hx-fallback {
    display: none;
    font-size: var(--t-small);
  }

  [data-gl-fallback] .hx-fallback {
    display: block;
  }

  .hx-after {
    min-height: 100vh;
    padding: var(--s-16) var(--grid-padding);
  }

  @media (max-width: 767px) {
    .hx {
      align-items: flex-end;
      padding-bottom: var(--s-12);
    }

    .hx-text {
      grid-column: 1 / -1;
    }
  }
</style>
