---
// /lab/hero-hm — spike hero „HUMAN / MACHINE” (tylko dev, noindex).
// Bohaterem jest sama strona: warstwa HUMAN (gotowe hero i Manifest) i warstwa MACHINE (ta sama
// struktura jako system: siatka, ramki, wymiary z DOM). Pasma szumu, plama pod kursorem i scroll
// odsłaniają MACHINE. Treść z BRIEF.md (01 Hero, 02 Manifest). MACHINE klonuje moduł z HUMAN.
import Base from '../../layouts/Base.astro';

const isDev = import.meta.env.DEV;
const cols = Array.from({ length: 12 }, (_, i) => String(i + 1).padStart(2, '0'));
---

{isDev ? (
  <Base title="Lab: hero HUMAN / MACHINE — webexe" noindex={true}>
    <!-- przed startem modułu widać tylko MACHINE (bez mignięcia HUMAN); bezpiecznik po 4 s -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('hm-pre');
        setTimeout(() => document.documentElement.classList.remove('hm-pre'), 4000);
      }
    </script>
    <div class="hm-gl" data-gl-wrap aria-hidden="true"></div>

    <section class="hm" data-module="hero-hm" aria-labelledby="hm-title">
      <div class="hm-stage" data-hm-stage>
        <div class="hm-layer hm-human" data-hm-human>
          <header class="hm-nav container" data-hm-el="header">
            <a class="hm-logo" href="#" data-hm-el="a.logo">
              webe<span class="hm-logo-x">x</span>e
            </a>
            <!-- TODO(treść): etykiety przełącznika do BRIEF, jeśli koncept przejdzie -->
            <div class="hm-toggle" role="group" aria-label="Widok strony" data-hm-el="div.toggle">
              <button type="button" data-hm-mode="human" aria-pressed="true">
                Human
              </button>
              <button type="button" data-hm-mode="machine" aria-pressed="false">
                Machine
              </button>
            </div>
            <a class="hm-pill" href="#kontakt" data-hm-el="a.nav">
              Kontakt
            </a>
          </header>

          <div class="hm-scene hm-hero container" data-hm-scene="hero">
            <h1 id="hm-title" class="hm-title" data-hm-el="h1" data-hm-title>
              <span class="hm-line" data-hm-line>
                Budujemy
              </span>
              <span class="hm-line" data-hm-line>
                oprogramowanie
              </span>
              <span class="hm-line" data-hm-line>
                dla firm i zostajemy
              </span>
              <span class="hm-line" data-hm-line>
                przy nim <span class="hm-accent">na lata.</span>
              </span>
            </h1>
            <div class="hm-foot" data-hm-fade>
              <p class="hm-lead" data-hm-el="p.lead">
                Aplikacje webowe, systemy wewnętrzne, integracje i automatyzacje z AI. Projektujemy
                je razem z wami, wdrażamy etapami i utrzymujemy na własnej infrastrukturze.
              </p>
              <!-- CTA: propozycja z D9, do potwierdzenia -->
              <a class="hm-cta" href="#kontakt" data-hm-el="a.cta">
                Porozmawiajmy o projekcie
              </a>
            </div>
          </div>

          <div class="hm-scene hm-manifest container" data-hm-scene="manifest">
            <div class="hm-manifest-text">
              <h2 class="hm-problem" data-hm-el="h2" data-hm-decode>
                Większość firmowego oprogramowania powstaje raz i zostaje bez opieki. Po kilku
                latach nikt nie wie, jak działa, a każda zmiana jest ryzykiem.
              </h2>
              <p class="hm-answer" data-hm-el="p" data-hm-decode>
                My budujemy tak, żeby dało się to rozwijać <span class="hm-accent">latami</span>. I
                sami to rozwijamy.
              </p>
              <svg class="hm-x" viewBox="0 0 40 40" data-hm-x aria-hidden="true">
                <defs>
                  <linearGradient id="hm-x-grad" x1="0" y1="0" x2="1" y2="1">
                    <stop class="hm-x-s1" offset="0" />
                    <stop class="hm-x-s2" offset="1" />
                  </linearGradient>
                </defs>
                <line x1="6" y1="6" x2="34" y2="34" />
                <line x1="34" y1="6" x2="6" y2="34" />
              </svg>
            </div>
          </div>
        </div>

        <div class="hm-layer hm-machine" data-hm-machine aria-hidden="true">
          <div class="hm-grid container">
            {cols.map((n) => (
              <span class="hm-col" data-hm-col>
                <span class="hm-col-n">{n}</span>
              </span>
            ))}
          </div>
          <!-- tu moduł wstawia klon warstwy HUMAN -->
        </div>
      </div>
    </section>

    <section class="hm-after" id="kontakt" aria-label="Miejsce na kolejne sekcje">
      <p class="hm-muted">TODO(treść): tu zaczyna się sekcja 03 (greybox w F3).</p>
    </section>
  </Base>
) : (
  <html lang="pl">
    <head>
      <meta charset="UTF-8" />
      <title>404</title>
    </head>
    <body>
      <p>Strona niedostępna.</p>
    </body>
  </html>
)}

<style>
  :global(body):has(.hm) {
    background: var(--c-piana);
    color: var(--c-glebia);
  }

  .hm-gl {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hm,
  .hm-after {
    position: relative;
    z-index: 1;
  }

  /* --- Układ statyczny (bez JS / reduced motion): hero, potem Manifest w zwykłym przepływie --- */
  .hm-stage {
    position: relative;
  }

  .hm-layer {
    display: flex;
    flex-direction: column;
  }

  .hm-scene {
    padding-block: var(--s-16);
  }

  .hm-machine {
    display: none;
  }

  /* --- Tryb live: sticky track, sceny jedna na drugiej, MACHINE nad HUMAN pod maską --- */
  .hm[data-hm-live] {
    height: calc(var(--hm-track, 5) * 100vh);
    height: calc(var(--hm-track, 5) * 100svh);
  }

  .hm[data-hm-live] .hm-stage,
  :global(.hm-pre) .hm-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 36rem;
    overflow: hidden;
  }

  .hm[data-hm-live] .hm-layer,
  :global(.hm-pre) .hm-layer {
    position: absolute;
    inset: 0;
  }

  .hm[data-hm-live] .hm-machine,
  :global(.hm-pre) .hm-machine {
    display: flex;
    background: var(--c-glebia);
    color: var(--c-piana);
    pointer-events: none;
    will-change: clip-path;
  }

  :global(.hm-pre) .hm-human {
    visibility: hidden;
  }

  .hm[data-hm-live] .hm-scene {
    position: absolute;
    inset: 0;
    padding-block: var(--s-24) var(--s-8);
  }

  .hm[data-hm-live] .hm-hero {
    align-content: space-between;
  }

  .hm[data-hm-live] .hm-manifest {
    align-content: center;
  }

  /* --- Nawigacja --- */
  .hm-nav {
    position: relative;
    z-index: 2;
    align-items: center;
    padding-block: var(--s-6);
  }

  .hm-logo {
    grid-column: 1 / 4;
    justify-self: start;
    color: inherit;
    font-size: var(--t-lead);
    font-weight: var(--w-h1);
    letter-spacing: var(--ls-h3);
    text-decoration: none;
  }

  .hm-logo-x {
    background: var(--g-laguna);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hm-toggle {
    grid-column: 5 / 9;
    justify-self: center;
    display: flex;
    padding: var(--s-1);
    border: 1px solid var(--c-piana-deep);
    border-radius: var(--r-pill);
  }

  .hm-toggle button {
    padding: var(--s-1) var(--s-4);
    border: 0;
    border-radius: var(--r-pill);
    background: none;
    color: var(--c-ink-muted);
    font: inherit;
    font-size: var(--t-small);
    font-weight: var(--w-label);
    cursor: pointer;
  }

  .hm-toggle button[aria-pressed='true'] {
    background: var(--c-glebia);
    color: var(--c-piana);
  }

  .hm-pill {
    grid-column: -4 / -1;
    justify-self: end;
    padding: var(--s-2) var(--s-6);
    border: 1px solid var(--c-piana-deep);
    border-radius: var(--r-pill);
    color: inherit;
    font-size: var(--t-small);
    font-weight: var(--w-label);
    text-decoration: none;
  }

  .hm-cta:focus-visible,
  .hm-pill:focus-visible,
  .hm-logo:focus-visible,
  .hm-toggle button:focus-visible {
    outline: 2px solid var(--c-laguna-ink);
    outline-offset: 4px;
  }

  /* --- Hero --- */
  .hm-hero {
    row-gap: var(--s-8);
  }

  .hm-title {
    grid-column: 1 / -1;
    justify-self: start;
    /* --hm-size: rozmiar dopasowany do szerokości kontenera, liczy moduł; bez JS token */
    font-size: var(--hm-size, var(--t-impact));
    font-weight: var(--w-impact);
    line-height: var(--lh-impact);
    letter-spacing: var(--ls-impact);
    text-transform: uppercase;
  }

  .hm-line {
    position: relative;
    display: block;
    width: max-content;
    white-space: nowrap;
  }

  .hm-accent {
    background: var(--g-laguna);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hm-foot {
    grid-column: 1 / -1;
    align-self: end;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-8);
  }

  .hm-lead {
    max-width: 40ch;
    font-size: var(--t-body);
    font-weight: var(--w-lead);
    line-height: var(--lh-body);
    color: var(--c-ink-muted);
  }

  .hm-cta {
    flex: none;
    padding: var(--s-4) var(--s-8);
    border-radius: var(--r-pill);
    background: var(--c-glebia);
    color: var(--c-piana);
    font-size: var(--t-body);
    font-weight: var(--w-label);
    line-height: var(--lh-label);
    text-decoration: none;
  }

  /* --- Manifest --- */
  .hm-manifest-text {
    grid-column: 2 / 12;
    display: flex;
    flex-direction: column;
    gap: var(--s-12);
  }

  .hm-problem,
  .hm-answer {
    font-size: var(--t-h2);
    font-weight: var(--w-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
  }

  .hm-problem {
    color: var(--c-ink-muted);
  }

  .hm-x {
    width: calc(var(--t-h2) * 1.3);
    height: auto;
    overflow: visible;
  }

  .hm-x line {
    fill: none;
    stroke: url(#hm-x-grad);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .hm-x-s1 {
    stop-color: var(--c-laguna-start);
  }

  .hm-x-s2 {
    stop-color: var(--c-laguna-end);
  }

  /* --- MACHINE: ta sama struktura jako system --- */
  .hm-grid {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .hm-col {
    position: relative;
    height: 100%;
    background: color-mix(in srgb, var(--c-glebia-line) 70%, transparent);
    transform-origin: top center;
  }

  :global(.hm-pre) .hm-col {
    transform: scaleY(0);
  }

  .hm-col-n {
    position: absolute;
    bottom: var(--s-4);
    left: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--t-small);
    color: var(--c-glebia-raise);
  }

  .hm-machine :global(.hm-clone) {
    color: var(--c-piana);
  }

  .hm-machine :global([data-hm-el]),
  .hm-machine :global([data-hm-line]) {
    position: relative;
    outline: 1px solid var(--c-laguna-start);
    outline-offset: 2px;
    background:
      linear-gradient(var(--c-laguna-start) 0 0) left top / 5px 5px no-repeat,
      linear-gradient(var(--c-laguna-start) 0 0) right top / 5px 5px no-repeat,
      linear-gradient(var(--c-laguna-start) 0 0) left bottom / 5px 5px no-repeat,
      linear-gradient(var(--c-laguna-start) 0 0) right bottom / 5px 5px no-repeat;
  }

  /* nawigacja w MACHINE: sam przełącznik bez ramki, żeby stan był czytelny */
  .hm-machine :global(.hm-nav) {
    outline-color: var(--c-glebia-raise);
  }

  /* etykieta: tag + wymiary, liczone przez moduł (data-tag, data-size) */
  .hm-machine :global([data-tag])::before {
    content: '<' attr(data-tag) '>  ' attr(data-size);
    position: absolute;
    left: 0;
    bottom: calc(100% + var(--s-1));
    font-family: var(--f-mono);
    font-size: var(--t-small);
    font-weight: var(--w-body);
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
    color: var(--c-laguna-start);
  }

  .hm-machine :global(.hm-nav[data-tag])::before {
    bottom: auto;
    top: calc(100% + var(--s-1));
    color: var(--c-glebia-raise);
  }

  /* wiersze nagłówka: wymiar po prawej i linia bazowa przez cały ekran */
  .hm-machine :global([data-hm-line])::before {
    content: attr(data-size);
    position: absolute;
    left: calc(100% + var(--s-3));
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--f-mono);
    font-size: var(--t-small);
    font-weight: var(--w-body);
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
    color: var(--c-laguna-end);
  }

  .hm-machine :global([data-hm-line][data-edge])::before {
    left: auto;
    right: var(--s-2);
    top: var(--s-2);
    transform: none;
  }

  .hm-machine :global([data-hm-line])::after {
    content: '';
    position: absolute;
    left: -100vw;
    right: -100vw;
    bottom: 0.12em;
    height: 1px;
    background: color-mix(in srgb, var(--c-laguna-start) 35%, transparent);
  }

  .hm-machine :global(.hm-title) {
    outline-color: var(--c-glebia-raise);
    color: transparent;
    -webkit-text-stroke: 1px var(--c-laguna-start);
  }

  .hm-machine :global(.hm-accent) {
    background: none;
    color: inherit;
    -webkit-text-stroke-color: var(--c-laguna-end);
  }

  .hm-machine :global(.hm-logo-x) {
    background: none;
    color: var(--c-laguna-end);
  }

  .hm-machine :global(.hm-toggle),
  .hm-machine :global(.hm-pill) {
    border-style: dashed;
    border-color: var(--c-laguna-start);
  }

  .hm-machine :global(.hm-toggle button) {
    color: var(--c-ink-muted-dark);
  }

  .hm-machine :global(.hm-toggle button[aria-pressed='true']) {
    background: var(--c-laguna-start);
    color: var(--c-glebia);
  }

  .hm-machine :global(.hm-lead) {
    color: var(--c-ink-muted-dark);
  }

  .hm-machine :global(.hm-problem),
  .hm-machine :global(.hm-answer) {
    color: transparent;
    -webkit-text-stroke: 1px var(--c-laguna-start);
  }

  .hm-machine :global(.hm-problem) {
    -webkit-text-stroke-color: var(--c-ink-muted-dark);
  }

  .hm-machine :global(.hm-cta) {
    background: none;
    border: 1px dashed var(--c-laguna-start);
    color: var(--c-laguna-start);
    font-family: var(--f-mono);
  }

  .hm-machine :global(.hm-x line) {
    stroke: var(--c-laguna-start);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }

  /* specyfikacja nagłówka (font-size, letter-spacing): wstawia moduł */
  .hm-machine :global(.hm-spec) {
    position: absolute;
    right: 0;
    top: calc(100% + var(--s-3));
    font-family: var(--f-mono);
    font-size: var(--t-small);
    font-weight: var(--w-body);
    line-height: var(--lh-small);
    letter-spacing: 0;
    text-transform: none;
    text-align: right;
    white-space: pre;
    color: var(--c-laguna-end);
    -webkit-text-stroke: 0;
  }

  /* przełącznik w trybie MACHINE: HUMAN pokazuje stan pod pełnym zalaniem */
  .hm[data-mode='machine'] .hm-human .hm-toggle {
    border-color: var(--c-glebia);
  }

  .hm-after {
    min-height: 100vh;
    padding: var(--s-16) var(--grid-padding);
  }

  .hm-muted {
    font-size: var(--t-small);
    color: var(--c-ink-muted);
  }

  @media (max-width: 767px) {
    .hm-logo {
      grid-column: 1 / 2;
    }

    .hm-toggle {
      grid-column: 2 / 4;
    }

    .hm-pill {
      display: none;
    }

    .hm-line {
      width: auto;
      white-space: normal;
    }

    .hm-foot {
      flex-direction: column;
      align-items: flex-start;
    }

    .hm-machine :global([data-hm-line])::before,
    .hm-machine :global(.hm-spec),
    .hm-machine :global(.hm-nav [data-tag])::before {
      display: none;
    }

    /* siatka mobile ma 4 kolumny */
    .hm-col:nth-child(n + 5) {
      display: none;
    }

    .hm-manifest-text {
      grid-column: 1 / -1;
    }
  }
</style>
