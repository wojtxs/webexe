---
// /lab/hero-arcs — spike hero „łuki” (tylko dev, noindex). Wzór: cerebrium.ai.
// Ciemna Głębia, grube matowe łuki w gradiencie Laguny (GL) ze smugami światła, nagłówek z lewej
// na dole, lead i CTA z prawej, marquee usług. Panel wjeżdża na hero: Manifest słowo po słowie
// i „Jak pracujemy” ze sticky listą kroków oraz żywymi mini-UI. Na końcu łuki wracają przy CTA.
// Treść z BRIEF.md (01, 02, 03). Panel jasny do porównania: ?panel=light.
import Base from '../../layouts/Base.astro';

const isDev = import.meta.env.DEV;
const services = ['Aplikacje', 'Integracje', 'Automatyzacje', 'Utrzymanie'];
const steps = [
  {
    n: '01',
    verb: 'Projektujemy',
    ui: 'design',
    text: 'Zaczynamy od tego, jak naprawdę pracujecie, a nie od technologii. Rozpisujemy proces, mówimy wprost, co warto zbudować, a czego nie, i wyceniamy zakres przed startem.',
  },
  {
    n: '02',
    verb: 'Budujemy',
    ui: 'build',
    text: 'Aplikacje webowe, panele, systemy wewnętrzne i integracje z tym, czego już używacie. Etapami: najpierw najważniejsza część, potem kolejne, każda po testach.',
  },
  {
    n: '03',
    verb: 'Automatyzujemy',
    ui: 'auto',
    text: 'Powtarzalną pracę przejmuje automat albo agent AI. Tam, gdzie decyzja ma znaczenie, system przygotowuje, a człowiek zatwierdza.',
  },
  {
    n: '04',
    verb: 'Utrzymujemy',
    ui: 'run',
    text: 'Serwery, kopie zapasowe, monitoring, aktualizacje i dalszy rozwój. Gdy coś trzeba zmienić, piszecie do ludzi, którzy to zbudowali.',
  },
];
const marquee = [...services, ...services, ...services];
---

{isDev ? (
  <Base title="Lab: hero łuki — webexe" noindex={true}>
    <script is:inline>
      const q = new URLSearchParams(location.search);
      if (q.get('panel') === 'light') document.documentElement.dataset.panel = 'light';
      if (q.get('accent') === 'comfortaa') document.documentElement.dataset.accent = 'comfortaa';
    </script>
    <div class="ha-gl" data-gl-wrap aria-hidden="true"></div>
    <div class="ha-dots" data-ha-dots aria-hidden="true"></div>
    <div class="ha-cursor" data-ha-cursor aria-hidden="true"></div>

    <div class="ha" data-module="hero-arcs">
      <header class="ha-nav container" data-ha-nav>
        <a class="ha-logo" href="#">
          webe<span class="ha-logo-x">x</span>e
        </a>
        <nav class="ha-links" aria-label="Główna">
          <a href="#jak-pracujemy">Jak pracujemy</a>
          <a href="#kontakt">Kontakt</a>
        </nav>
        <!-- CTA: propozycja z D9, do potwierdzenia -->
        <a class="ha-btn ha-btn-primary ha-nav-cta" href="#kontakt">
          Porozmawiajmy o projekcie
        </a>
      </header>

      <section class="ha-hero" data-ha-hero aria-labelledby="ha-title">
        <div class="ha-hero-main container">
          <h1 id="ha-title" class="ha-title">
            <span class="ha-line">
              <span class="ha-line-in" data-ha-line>
                Budujemy
              </span>
            </span>
            <span class="ha-line">
              <span class="ha-line-in" data-ha-line>
                oprogramowanie
              </span>
            </span>
            <span class="ha-line">
              <span class="ha-line-in" data-ha-line>
                dla firm i zostajemy
              </span>
            </span>
            <span class="ha-line">
              <span class="ha-line-in" data-ha-line>
                przy nim <span class="ha-accent">na lata.</span>
              </span>
            </span>
          </h1>
          <div class="ha-side" data-ha-side>
            <p class="ha-lead">
              Aplikacje webowe, systemy wewnętrzne, integracje i automatyzacje z AI. Projektujemy je
              razem z wami, wdrażamy etapami i utrzymujemy na własnej infrastrukturze.
            </p>
            <div class="ha-actions">
              <a class="ha-btn ha-btn-primary" href="#kontakt">
                Porozmawiajmy o projekcie
              </a>
              <a class="ha-btn ha-btn-ghost" href="#jak-pracujemy">
                Jak pracujemy
              </a>
            </div>
          </div>
        </div>
        <div class="ha-rule container" aria-hidden="true">
          <span data-ha-rule></span>
        </div>
        <div class="ha-marquee" data-ha-marquee>
          <p class="sr-only">{services.join(', ')}</p>
          <div class="ha-marquee-track" data-ha-track aria-hidden="true">
            {[0, 1].map(() => (
              <span class="ha-marquee-set">
                {marquee.map((s) => (
                  <span class="ha-marquee-item">
                    {s}
                    <span class="ha-x">x</span>
                  </span>
                ))}
              </span>
            ))}
          </div>
        </div>
      </section>

      <div class="ha-gap" aria-hidden="true"></div>

      <section class="ha-panel" data-ha-panel>
        <div class="ha-manifest container" data-ha-manifest aria-label="Manifest">
          <p class="ha-problem" data-ha-words>
            Większość firmowego oprogramowania powstaje raz i zostaje bez opieki. Po kilku latach
            nikt nie wie, jak działa, a każda zmiana jest ryzykiem.
          </p>
          <p class="ha-answer" data-ha-words>
            My budujemy tak, żeby dało się to rozwijać <span class="ha-accent">latami</span>. I sami
            to rozwijamy.
          </p>
          <svg class="ha-xmark" viewBox="0 0 40 40" data-ha-xmark aria-hidden="true">
            <defs>
              <linearGradient id="ha-x-grad" x1="0" y1="0" x2="1" y2="1">
                <stop class="ha-stop-1" offset="0" />
                <stop class="ha-stop-2" offset="1" />
              </linearGradient>
            </defs>
            <line x1="6" y1="6" x2="34" y2="34" />
            <line x1="34" y1="6" x2="6" y2="34" />
          </svg>
        </div>

        <div class="ha-process container" id="jak-pracujemy" data-ha-process>
          <h2 class="ha-process-title">Jak pracujemy</h2>
          <ol class="ha-steps-nav" aria-hidden="true">
            {steps.map((s, i) => (
              <li data-ha-nav-step={i} class={i === 0 ? 'is-active' : ''}>
                <span class="ha-steps-n">{s.n} / 04</span>
                <span class="ha-steps-verb">{s.verb}</span>
              </li>
            ))}
          </ol>
          <div class="ha-steps">
            {steps.map((s, i) => (
              <article class="ha-step" data-ha-step={i}>
                <div class={`ha-card ha-card-${s.ui}`} data-ha-ui={s.ui} aria-hidden="true">
                  {s.ui === 'design' && (
                    <svg class="ha-flow" viewBox="0 0 400 260">
                      <path data-ha-edge d="M80 70 C150 70 150 130 200 130" />
                      <path data-ha-edge d="M80 190 C150 190 150 130 200 130" />
                      <path data-ha-edge d="M260 130 C300 130 300 70 330 70" />
                      <path data-ha-edge d="M260 130 C300 130 300 190 330 190" />
                      <path class="ha-flow-cut" data-ha-edge d="M330 190 L370 230" />
                      <circle class="ha-flow-dot" r="4" data-ha-dot />
                      <g data-ha-node>
                        <rect x="20" y="50" width="60" height="40" rx="8" />
                        <rect class="ha-sk" x="32" y="64" width="36" height="5" rx="2.5" />
                        <rect class="ha-sk" x="32" y="74" width="22" height="5" rx="2.5" />
                      </g>
                      <g data-ha-node>
                        <rect x="20" y="170" width="60" height="40" rx="8" />
                        <rect class="ha-sk" x="32" y="184" width="36" height="5" rx="2.5" />
                        <rect class="ha-sk" x="32" y="194" width="22" height="5" rx="2.5" />
                      </g>
                      <g data-ha-node>
                        <rect class="ha-flow-core" x="200" y="104" width="60" height="52" rx="10" />
                        <rect class="ha-sk" x="212" y="120" width="36" height="5" rx="2.5" />
                        <rect class="ha-sk" x="212" y="130" width="28" height="5" rx="2.5" />
                        <rect class="ha-sk" x="212" y="140" width="18" height="5" rx="2.5" />
                      </g>
                      <g data-ha-node>
                        <rect x="330" y="50" width="50" height="40" rx="8" />
                        <rect class="ha-sk" x="340" y="66" width="30" height="5" rx="2.5" />
                      </g>
                      <g data-ha-node>
                        <rect class="ha-flow-skip" x="330" y="170" width="50" height="40" rx="8" />
                        <path class="ha-flow-cross" d="M346 182 L364 198 M364 182 L346 198" />
                      </g>
                    </svg>
                  )}
                  {s.ui === 'build' && (
                    <div class="ha-app">
                      <div class="ha-app-bar">
                        <i></i>
                        <i></i>
                        <i></i>
                        <span class="ha-app-url" data-ha-piece></span>
                      </div>
                      <div class="ha-app-body">
                        <div class="ha-app-side" data-ha-piece>
                          <span class="ha-sk-line is-accent"></span>
                          <span class="ha-sk-line"></span>
                          <span class="ha-sk-line"></span>
                          <span class="ha-sk-line"></span>
                        </div>
                        <div class="ha-app-main">
                          <div class="ha-app-head" data-ha-piece>
                            <span class="ha-sk-line is-wide"></span>
                            <span class="ha-app-btn"></span>
                          </div>
                          <div class="ha-app-grid">
                            <div class="ha-app-tile" data-ha-piece>
                              <span class="ha-sk-line"></span>
                              <span class="ha-app-bars">
                                <i style="--h:0.4"></i>
                                <i style="--h:0.7"></i>
                                <i style="--h:0.55"></i>
                                <i style="--h:0.9"></i>
                                <i style="--h:0.65"></i>
                              </span>
                            </div>
                            <div class="ha-app-tile" data-ha-piece>
                              <span class="ha-sk-line"></span>
                              <span class="ha-app-ring"></span>
                            </div>
                            <div class="ha-app-tile ha-app-wide" data-ha-piece>
                              <span class="ha-app-row"></span>
                              <span class="ha-app-row"></span>
                              <span class="ha-app-row"></span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  )}
                  {s.ui === 'auto' && (
                    <div class="ha-pipe">
                      <div class="ha-pipe-lane">
                        <div class="ha-pipe-stage">
                          <span class="ha-pipe-label">system przygotowuje</span>
                          <span class="ha-pipe-progress">
                            <i data-ha-progress></i>
                          </span>
                        </div>
                        <span class="ha-pipe-link">
                          <i data-ha-link></i>
                        </span>
                        <div class="ha-pipe-stage ha-pipe-human">
                          <span class="ha-pipe-label">człowiek zatwierdza</span>
                          <span class="ha-pipe-approve" data-ha-approve>
                            <svg viewBox="0 0 24 24">
                              <path d="M5 12.5 L10 17 L19 7" />
                            </svg>
                          </span>
                        </div>
                      </div>
                      <div class="ha-doc" data-ha-doc>
                        <span class="ha-sk-line is-accent"></span>
                        <span class="ha-sk-line"></span>
                        <span class="ha-sk-line is-short"></span>
                      </div>
                      <div class="ha-pipe-done" data-ha-done>
                        <span></span>
                        <span></span>
                        <span></span>
                      </div>
                    </div>
                  )}
                  {s.ui === 'run' && (
                    <div class="ha-mon">
                      <svg class="ha-mon-chart" viewBox="0 0 400 120" preserveAspectRatio="none">
                        <g data-ha-chart>
                          <path class="ha-mon-area" data-ha-area />
                          <path class="ha-mon-line" data-ha-line-path />
                        </g>
                      </svg>
                      <div class="ha-mon-rows">
                        {[0, 1, 2].map((r) => (
                          <div class="ha-mon-row">
                            <span class="ha-mon-dot" data-ha-pulse style={`--d:${r * 0.4}s`}></span>
                            <span class="ha-sk-line"></span>
                            <span class="ha-mon-meter">
                              <i data-ha-meter style={`--w:${[0.42, 0.66, 0.3][r]}`}></i>
                            </span>
                          </div>
                        ))}
                        <div class="ha-mon-row ha-mon-backup">
                          <span class="ha-mon-disk"></span>
                          <span class="ha-mon-bar">
                            <i data-ha-backup></i>
                          </span>
                        </div>
                      </div>
                    </div>
                  )}
                </div>
                <p class="ha-step-n">{s.n} / 04</p>
                <h3 class="ha-step-verb">{s.verb}</h3>
                <p class="ha-step-text">{s.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="ha-cta" id="kontakt" data-ha-cta aria-label="Kontakt">
        <div class="ha-cta-inner container">
          <!-- TODO(treść): CTA końcowe i dane kontaktowe (D9, sekcja 07) -->
          <a class="ha-cta-link" href="#kontakt" data-ha-cta-link>
            Porozmawiajmy o projekcie<span class="ha-x">x</span>
          </a>
        </div>
      </section>
    </div>
  </Base>
) : (
  <html lang="pl">
    <head>
      <meta charset="UTF-8" />
      <title>404</title>
    </head>
    <body>
      <p>Strona niedostępna.</p>
    </body>
  </html>
)}

<style>
  :global(body):has(.ha) {
    background: var(--c-wegiel);
    color: var(--c-kosc);
  }

  /* --- Warstwy tła: GL, kropki nad łukami, kursor --- */
  .ha-gl {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .ha-gl[data-fallback] {
    background:
      radial-gradient(60% 70% at 80% 100%, var(--c-bursztyn-end), transparent 70%), var(--c-wegiel);
  }

  .ha-dots {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--c-kosc) 45%, transparent) 1px,
      transparent 1.5px
    );
    background-size: var(--s-24) var(--s-24);
    background-position: calc(var(--s-24) / 2) calc(var(--s-24) / 2);
    mask-image: linear-gradient(to bottom, transparent 30%, black 75%);
    opacity: 0.5;
  }

  .ha-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 5;
    width: var(--s-12);
    height: var(--s-12);
    margin: calc(var(--s-12) / -2) 0 0 calc(var(--s-12) / -2);
    border: 1px solid color-mix(in srgb, var(--c-kosc) 60%, transparent);
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    transition:
      opacity var(--d-fast) var(--ease-out),
      width var(--d-fast) var(--ease-out),
      height var(--d-fast) var(--ease-out),
      margin var(--d-fast) var(--ease-out),
      background-color var(--d-fast) var(--ease-out);
  }

  .ha-cursor:global(.is-on) {
    opacity: 1;
  }

  .ha-cursor:global(.is-down) {
    width: var(--s-24);
    height: var(--s-24);
    margin: calc(var(--s-24) / -2) 0 0 calc(var(--s-24) / -2);
    background: color-mix(in srgb, var(--c-bursztyn-end) 18%, transparent);
  }

  .ha {
    position: relative;
    z-index: 2;
  }

  /* --- Przyciski --- */
  .ha-btn {
    display: inline-flex;
    align-items: center;
    padding: var(--s-3) var(--s-6);
    border-radius: var(--r-chip);
    font-size: var(--t-small);
    font-weight: var(--w-label);
    line-height: var(--lh-label);
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform var(--d-fast) var(--ease-out),
      background-color var(--d-fast) var(--ease-out);
  }

  .ha-btn-primary {
    background: var(--g-bursztyn);
    color: var(--c-wegiel);
  }

  .ha-btn-ghost {
    background: var(--c-kawa);
    color: var(--c-kosc);
  }

  .ha-btn:hover {
    transform: translateY(-2px);
  }

  .ha a:focus-visible {
    outline: 2px solid var(--c-bursztyn-end);
    outline-offset: 4px;
  }

  /* --- Nawigacja --- */
  .ha-nav {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    align-items: center;
    padding-block: var(--s-6);
  }

  /* wordmark: Comfortaa 700 małymi literami, x w Bursztynie (jak na planszy marki) */
  .ha-logo {
    grid-column: 1 / 4;
    justify-self: start;
    color: inherit;
    font-family: var(--f-accent);
    font-size: var(--t-h3);
    font-weight: var(--w-h3);
    letter-spacing: var(--ls-h3);
    text-decoration: none;
  }

  .ha-logo-x,
  .ha-accent,
  .ha-x {
    background: var(--g-bursztyn);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* znak x: Comfortaa 700; słowa-akcenty w kroju nagłówka (Comfortaa do porównania: ?accent=comfortaa) */
  .ha-x,
  :global(html[data-accent='comfortaa']) .ha-accent {
    font-family: var(--f-accent);
    font-weight: var(--w-h3);
    letter-spacing: var(--ls-h3);
  }

  .ha-links {
    grid-column: 5 / 9;
    justify-self: center;
    display: flex;
    gap: var(--s-1);
    padding: var(--s-1);
    border: 1px solid var(--c-kawa);
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--c-wegiel) 70%, transparent);
    backdrop-filter: blur(8px);
  }

  .ha-links a {
    padding: var(--s-2) var(--s-4);
    border-radius: var(--r-pill);
    color: var(--c-kosc-muted);
    font-size: var(--t-small);
    font-weight: var(--w-small);
    text-decoration: none;
    transition: color var(--d-fast) var(--ease-out);
  }

  .ha-links a:hover {
    color: var(--c-kosc);
  }

  .ha-nav-cta {
    grid-column: 10 / 13;
    justify-self: end;
  }

  /* --- Hero --- */
  .ha-hero {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: var(--s-32);
  }

  .ha-hero-main {
    position: relative;
    align-items: end;
    row-gap: var(--s-8);
    padding-bottom: var(--s-12);
  }

  .ha-title {
    grid-column: 1 / 9;
    font-size: var(--t-h1);
    font-weight: var(--w-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--ls-h1);
  }

  .ha-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .ha-line-in {
    display: block;
  }

  .ha-side {
    grid-column: 9 / 13;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .ha-lead {
    color: var(--c-kosc-muted);
    font-size: var(--t-body);
    line-height: var(--lh-body);
  }

  .ha-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .ha-rule span {
    grid-column: 1 / -1;
    display: block;
    height: 1px;
    background: var(--c-kawa);
    transform-origin: left;
  }

  .ha-marquee {
    overflow: hidden;
    padding-block: var(--s-8);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .ha-marquee-track {
    display: flex;
    width: max-content;
  }

  .ha-marquee-set {
    display: flex;
    flex: none;
  }

  .ha-marquee-item {
    display: inline-flex;
    align-items: center;
    gap: var(--s-8);
    padding-right: var(--s-8);
    color: var(--c-kosc-muted);
    font-size: var(--t-h3);
    font-weight: var(--w-h3);
    letter-spacing: var(--ls-h3);
    white-space: nowrap;
  }

  .ha-marquee-item .ha-x {
    font-weight: var(--w-h1);
  }

  .ha-gap {
    height: 45vh;
    height: 45svh;
  }

  /* --- Panel: domyślnie ciemny raise, ?panel=light jasna Piana --- */
  .ha-panel {
    --pn-bg: var(--c-kawa);
    --pn-ink: var(--c-kosc);
    --pn-muted: var(--c-kosc-muted);
    --pn-dim: color-mix(in srgb, var(--c-kosc) 22%, transparent);
    --pn-card: var(--c-wegiel);
    --pn-line: var(--c-kawa-line);
    --pn-sk: color-mix(in srgb, var(--c-kosc) 14%, transparent);
    position: relative;
    padding-block: var(--s-32);
    border-radius: var(--r-panel);
    background: var(--pn-bg);
    color: var(--pn-ink);
    transform-origin: 50% 0;
  }

  :global(html[data-panel='light']) .ha-panel {
    --pn-bg: var(--c-kosc);
    --pn-ink: var(--c-wegiel);
    --pn-muted: var(--c-ink-warm);
    --pn-dim: color-mix(in srgb, var(--c-wegiel) 22%, transparent);
    --pn-card: var(--c-biel);
    --pn-line: var(--c-kosc-line);
    --pn-sk: var(--c-kosc-line);
  }

  /* --- Manifest --- */
  .ha-manifest {
    row-gap: var(--s-12);
    padding-bottom: var(--s-32);
  }

  .ha-problem,
  .ha-answer {
    grid-column: 1 / 11;
    font-size: var(--t-h2);
    font-weight: var(--w-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h2);
  }

  .ha-problem {
    color: var(--pn-muted);
  }

