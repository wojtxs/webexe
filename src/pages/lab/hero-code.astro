---
// /lab/hero-code — spike: znak x z kodu, jedna scena przez całą stronę (tylko dev, noindex).
// Mechanika wzorem endurosat.com/space-service (scena płynie pod sekcjami, tekst odsłaniany na
// scenie, kroki po bokach obiektu), motyw nasz: kod, porządek, budowa, automatyzacja, utrzymanie.
// Sekcje z data-hc-key to klatki kluczowe sceny (src/modules/hero-code.ts). Treść z BRIEF.md (01–03).
import Base from '../../layouts/Base.astro';

const isDev = import.meta.env.DEV;
const lines = ['Budujemy', 'oprogramowanie', 'dla firm i zostajemy'];
const steps = [
  {
    n: '01 / 04',
    verb: 'Projektujemy',
    text: 'Zaczynamy od tego, jak naprawdę pracujecie, a nie od technologii. Rozpisujemy proces, mówimy wprost, co warto zbudować, a czego nie, i wyceniamy zakres przed startem.',
  },
  {
    n: '02 / 04',
    verb: 'Budujemy',
    text: 'Aplikacje webowe, panele, systemy wewnętrzne i integracje z tym, czego już używacie. Etapami: najpierw najważniejsza część, potem kolejne, każda po testach.',
  },
  {
    n: '03 / 04',
    verb: 'Automatyzujemy',
    text: 'Powtarzalną pracę przejmuje automat albo agent AI. Tam, gdzie decyzja ma znaczenie, system przygotowuje, a człowiek zatwierdza.',
  },
  {
    n: '04 / 04',
    verb: 'Utrzymujemy',
    text: 'Serwery, kopie zapasowe, monitoring, aktualizacje i dalszy rozwój. Gdy coś trzeba zmienić, piszecie do ludzi, którzy to zbudowali.',
  },
];
---

{isDev ? (
  <Base title="Lab: hero kod — webexe" noindex={true}>
    <div class="hc-gl" data-gl-wrap aria-hidden="true"></div>

    <div class="hc" data-module="hero-code">
      <header class="hc-nav container">
        <a class="hc-logo" href="#">
          webe<span class="hc-logo-x">x</span>e
        </a>
        <nav class="hc-links" aria-label="Główna">
          <a href="#jak-pracujemy">Jak pracujemy</a>
          <a href="#kontakt">Kontakt</a>
        </nav>
        <!-- CTA: propozycja z D9, do potwierdzenia -->
        <a class="hc-btn hc-btn-primary hc-nav-cta" href="#kontakt">
          Porozmawiajmy o projekcie
        </a>
      </header>

      <main>
        <section class="hc-hero hc-sec container" data-hc-key="hero" aria-labelledby="hc-title">
          <div class="hc-col">
            <h1 id="hc-title" class="hc-title">
              {lines.map((l) => (
                <span class="hc-row" data-hc-row>
                  <span class="hc-line" data-hc-line>
                    {l}
                  </span>
                </span>
              ))}
              <span class="hc-row" data-hc-row>
                <span class="hc-line" data-hc-line>
                  przy nim <span class="hc-accent">na lata.</span>
                </span>
              </span>
            </h1>
            <div class="hc-side" data-hc-side>
              <p class="hc-lead">
                Aplikacje webowe, systemy wewnętrzne, integracje i automatyzacje z AI. Projektujemy
                je razem z wami, wdrażamy etapami i utrzymujemy na własnej infrastrukturze.
              </p>
              <div class="hc-actions">
                <a class="hc-btn hc-btn-primary" href="#kontakt">
                  Porozmawiajmy o projekcie
                </a>
                <a class="hc-btn hc-btn-ghost" href="#jak-pracujemy">
                  Jak pracujemy
                </a>
              </div>
            </div>
          </div>
        </section>

        <section class="hc-sec container" data-hc-key="problem" aria-label="Manifest">
          <div class="hc-col">
            <p class="hc-problem" data-hc-words>
              Większość firmowego oprogramowania powstaje raz i zostaje bez opieki. Po kilku latach
              nikt nie wie, jak działa, a każda zmiana jest ryzykiem.
            </p>
          </div>
        </section>

        <section class="hc-sec container" data-hc-key="answer">
          <div class="hc-col">
            <p class="hc-answer" data-hc-words>
              My budujemy tak, żeby dało się to rozwijać <span class="hc-accent">latami.</span> I
              sami to rozwijamy.
            </p>
          </div>
        </section>

        <section id="jak-pracujemy" class="hc-steps" aria-labelledby="hc-steps-title">
          <div class="hc-sec hc-sec-center container" data-hc-key="steps">
            <h2 id="hc-steps-title" class="hc-steps-title" data-hc-title>
              Jak pracujemy
            </h2>
          </div>
          {steps.map((s, i) => (
            <article
              class:list={['hc-sec hc-step container', i % 2 ? 'hc-step-right' : 'hc-step-left']}
              data-hc-key={`step${i + 1}`}
              data-hc-step={i % 2 ? 'right' : 'left'}
            >
              <div class="hc-col">
                <p class="hc-step-n" data-hc-fade>
                  {s.n}
                </p>
                <h3 class="hc-step-verb" data-hc-verb>
                  {s.verb}
                </h3>
                <p class="hc-step-text" data-hc-fade>
                  {s.text}
                </p>
              </div>
            </article>
          ))}
        </section>

        <section class="hc-sec hc-sec-center hc-end container" id="kontakt" data-hc-key="end">
          <!-- TODO(treść): sekcje 04–07 z BRIEF i właściwy kontakt; tu tylko koniec spike'a -->
          <a class="hc-end-cta" href="#kontakt">
            <span class="hc-row">
              <span class="hc-line" data-hc-end-line>
                Porozmawiajmy
              </span>
            </span>
            <span class="hc-row">
              <span class="hc-line" data-hc-end-line>
                o <span class="hc-accent">projekcie</span>
              </span>
            </span>
          </a>
        </section>
      </main>

      <a class="hc-btn hc-btn-primary hc-dock" href="#kontakt" data-hc-dock>
        Porozmawiajmy o projekcie
      </a>
    </div>
  </Base>
) : (
  <p>Lab dostępny tylko w trybie dev.</p>
)}

<style>
  :global(body):has(.hc) {
    background: var(--c-wegiel);
    color: var(--c-kosc);
  }

  .hc-gl {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hc-gl[data-fallback] {
    background: radial-gradient(
      circle at 70% 46%,
      color-mix(in srgb, var(--c-bursztyn-end) 22%, transparent),
      transparent 40%
    );
  }

  .hc {
    position: relative;
    z-index: 2;
  }

  .hc a:focus-visible {
    outline: 2px solid var(--c-bursztyn-end);
    outline-offset: 4px;
  }

  /* --- Przyciski --- */
  .hc-btn {
    display: inline-flex;
    align-items: center;
    padding: var(--s-3) var(--s-6);
    border-radius: var(--r-chip);
    font-size: var(--t-small);
    font-weight: var(--w-label);
    line-height: var(--lh-label);
    text-decoration: none;
    white-space: nowrap;
    transition: transform var(--d-fast) var(--ease-out);
  }

  .hc-btn-primary {
    background: var(--g-bursztyn);
    color: var(--c-wegiel);
  }

  .hc-btn-ghost {
    background: color-mix(in srgb, var(--c-kawa) 80%, transparent);
    color: var(--c-kosc);
    backdrop-filter: blur(8px);
  }

  .hc-btn:hover {
    transform: translateY(-2px);
  }

  /* --- Nawigacja --- */
  .hc-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--s-6);
    padding-bottom: var(--s-6);
  }

  .hc-logo {
    font-family: var(--f-accent);
    font-size: var(--t-h3);
    font-weight: 700;
    color: var(--c-kosc);
    text-decoration: none;
    letter-spacing: var(--ls-h3);
  }

  .hc-logo-x,
  .hc-accent {
    background: var(--g-bursztyn);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hc-links {
    display: flex;
    gap: var(--s-8);
    padding: var(--s-3) var(--s-8);
    border: 1px solid color-mix(in srgb, var(--c-kosc) 14%, transparent);
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--c-wegiel) 55%, transparent);
    backdrop-filter: blur(10px);
  }

  .hc-links a {
    color: color-mix(in srgb, var(--c-kosc) 80%, transparent);
    font-size: var(--t-small);
    text-decoration: none;
  }

  /* --- Sekcje: każda wypełnia ekran, tekst po stronie bez znaku --- */
  .hc-sec {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), 1fr);
    column-gap: var(--grid-gap);
    align-content: center;
    min-height: 100svh;
    padding-top: var(--s-16);
    padding-bottom: var(--s-16);
  }

  .hc-col {
    grid-column: 1 / 7;
  }

  .hc-step-right .hc-col {
    grid-column: 8 / 13;
  }

  .hc-sec-center {
    justify-items: center;
    text-align: center;
  }

  .hc-sec-center > * {
    grid-column: 1 / -1;
  }

  /* --- Hero --- */
  .hc-title {
    margin: 0 0 var(--s-8);
    font-size: calc(var(--t-h1) * 1.1);
    font-weight: var(--w-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--ls-h1);
  }

  .hc-row {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .hc-line {
    display: block;
  }

  .hc-lead {
    max-width: 34rem;
    margin: 0 0 var(--s-8);
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: color-mix(in srgb, var(--c-kosc) 78%, transparent);
  }

  .hc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  /* --- Manifest --- */
  .hc-problem {
    margin: 0;
    font-size: var(--t-h3);
    font-weight: var(--w-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
  }

  .hc-answer {
    margin: 0;
    font-size: var(--t-h2);
    font-weight: var(--w-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
  }

  /* --- Jak pracujemy --- */
  .hc-steps-title {
    margin: 0;
    font-size: min(var(--t-impact), 11vw);
    font-weight: var(--w-impact);
    line-height: var(--lh-impact);
    letter-spacing: var(--ls-impact);
  }

  .hc-step-n {
    margin: 0 0 var(--s-4);
    font-family: var(--f-mono);
    font-size: var(--t-small);
    color: var(--c-bursztyn-start);
  }

  .hc-step-verb {
    margin: 0 0 var(--s-6);
    font-size: min(calc(var(--t-h1) * 1.3), 7.2vw);
    font-weight: var(--w-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--ls-h1);
  }

  .hc-step-text {
    max-width: 30rem;
    margin: 0;
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: color-mix(in srgb, var(--c-kosc) 78%, transparent);
  }

  /* --- Koniec --- */
  .hc-end-cta {
    color: var(--c-kosc);
    font-size: min(var(--t-impact), 12vw);
    font-weight: var(--w-impact);
    line-height: var(--lh-impact);
    letter-spacing: var(--ls-impact);
    text-decoration: none;
  }

  .hc-dock {
    position: fixed;
    right: var(--grid-padding);
    bottom: var(--s-6);
    z-index: 4;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--d-fast) var(--ease-out),
      visibility var(--d-fast),
      transform var(--d-fast) var(--ease-out);
  }

  .hc-dock:global(.is-on) {
    opacity: 1;
    visibility: visible;
  }

  @media (max-width: 767px) {
    .hc-links,
    .hc-nav-cta {
      display: none;
    }

    .hc-sec {
      align-content: end;
    }

    .hc-col,
    .hc-step-right .hc-col {
      grid-column: 1 / -1;
    }

    .hc-sec-center {
      align-content: center;
    }

    .hc-title {
      font-size: var(--t-h1);
    }

    .hc-step-verb {
      font-size: min(var(--t-h1), 11vw);
    }
  }
</style>
