---
import Base from '../layouts/Base.astro';
---

<Base title="Nie znaleziono strony — webexe" noindex={true}>
  <section style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:var(--s-8);padding:var(--s-16) var(--grid-padding);">
    <h1 style="font-size:var(--t-h2);font-weight:var(--w-h2);line-height:var(--lh-h2);">
      Strona nie istnieje
    </h1>
    <a href="/" style="color:var(--c-laguna-ink);">
      Wróć na stronę główną
    </a>
  </section>
</Base>
