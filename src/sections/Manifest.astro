---
/**
 * 02 Manifest (docs/sections/02-manifest.md). Tekst wypełnia się scrollem słowo po słowie,
 * na końcu tor x-zoom: znak x rysuje się dwiema kreskami, zoom przez jego środek
 * otwiera ciemną część strony.
 */
import Grid from '../components/Grid.astro';
import XMark from '../components/XMark.astro';
import '../styles/sections/manifest.css';
---

<section
  id="manifest"
  class="manifest theme-light"
  data-nav-theme="light"
  aria-labelledby="manifest-title"
>
  <Grid />

  <div class="container manifest__body" data-module="scroll-fill">
    <h2 id="manifest-title" class="sr-only">
      Manifest
    </h2>
    <p class="manifest__problem t-h3" data-scroll-fill="text">
      Większość firmowego oprogramowania powstaje raz i zostaje bez opieki. Po kilku latach nikt nie
      wie, jak działa, a każda zmiana jest ryzykiem.
    </p>
    <p class="manifest__answer t-h2" data-scroll-fill="text">
      My budujemy tak, żeby dało się to rozwijać <span class="accent">latami</span>. I sami to
      rozwijamy.
    </p>
  </div>

  <div class="xzoom sticky-track" data-module="x-zoom">
    <div class="sticky-item xzoom__stage">
      <div class="xzoom__mark" data-x-zoom="mark">
        <XMark />
      </div>
    </div>
  </div>
</section>
