---
/**
 * 05 Jak pracujemy — eksperyment. Desktop: akordeon 4 kolumn (docs/INSPIRACJE.md, Oferta);
 * otwarta kolumna przechodzi w Głębię i pokazuje podgląd etapu (HwwViz), zwinięte pokazują
 * duży numer. Poniżej 992 px: stos paneli sticky z podglądem. Ruch podglądów: modules/hww.ts.
 */
import Grid from '../components/Grid.astro';
import HwwViz from '../components/HwwViz.astro';
import '../styles/sections/how-we-work.css';

// TODO(treść): D10, przykładowe rozwiązania z wersji 1 do potwierdzenia
const steps = [
  {
    n: '01 / 04',
    title: 'Projektujemy',
    viz: 'map',
    text: 'Na początku poznajemy proces, który chcecie usprawnić. Sprawdzamy, jakich systemów już używacie, co można z nimi połączyć i gdzie potrzebne będzie nowe oprogramowanie. Ustalamy zakres pierwszego etapu i przygotowujemy wycenę.',
    examples: [],
  },
  {
    n: '02 / 04',
    title: 'Budujemy',
    viz: 'code',
    text: 'Dzielimy pracę na etapy, żeby nie trzeba było czekać do końca projektu na zobaczenie efektów. Udostępniamy kolejne wersje do sprawdzenia, zbieramy uwagi i testujemy funkcje przed wdrożeniem.',
    examples: [
      'Systemy zarządzania zleceniami i projektami',
      'Aplikacje do obsługi klientów i pracowników',
      'Panele administracyjne i systemy wewnętrzne',
      'Dedykowane narzędzia do zarządzania danymi',
    ],
  },
  {
    n: '03 / 04',
    title: 'Automaty­zujemy', // miękki dział dla zwiniętej kolumny akordeonu
    viz: 'agent',
    text: 'Podłączamy potrzebne systemy, przygotowujemy przepływ danych i automatyzujemy wybrane czynności. Sprawdzamy również sytuacje, w których coś pójdzie nie tak — na przykład zewnętrzny system przestanie odpowiadać albo dokument będzie zawierał niepełne dane.',
    examples: [
      'Automatyczne przetwarzanie dokumentów i danych',
      'Generowanie raportów, ofert i zestawień',
      'Automatyzacja obiegu informacji',
      'Wykorzystanie AI do wspomagania codziennych zadań',
    ],
  },
  {
    n: '04 / 04',
    title: 'Utrzymujemy',
    viz: 'monitor',
    text: 'Serwery, kopie zapasowe, monitoring, aktualizacje i dalszy rozwój. Gdy coś trzeba zmienić, piszecie do ludzi, którzy to zbudowali.',
    examples: [],
  },
] as const;
---

<section
  id="jak-pracujemy"
  class="section hww theme-light"
  data-nav-theme="light"
  aria-labelledby="hww-title"
>
  <Grid />

  <div class="container">
    <h2 id="hww-title" class="section__title t-h2" data-split="words">
      Jak pracujemy
    </h2>
  </div>

  <ol class="container hww__steps" data-module="hww">
    {steps.map((step, i) => (
      <li class="hww__step" tabindex="0" data-hww-step>
        <div class="hww__card">
          <div class="hww__head">
            <p class="hww__num t-label muted">{step.n}</p>
            <h3 class="hww__title t-h3">{step.title}</h3>
          </div>

          <div class="hww__visual">
            <HwwViz kind={step.viz} />
          </div>

          <div class="hww__foot">
            <p class="hww__index" aria-hidden="true">{`0${i + 1}`}</p>
            <div class="hww__body">
              <p class="hww__text">{step.text}</p>
              {step.examples.length > 0 && (
                <div class="hww__examples">
                  <p class="t-label muted">Przykładowe rozwiązania</p>
                  <ul class="hww__list t-small">
                    {step.examples.map((example) => (
                      <li>{example}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>
