---
/**
 * 04 Produkt — greybox (F3). Jeden produkt naraz na laptopie i telefonie, na telefonie
 * nagranie ekranu, paralaksa scrollem w F5 (docs/INSPIRACJE.md). Cała treść zależy od D3.
 */
import { Image } from 'astro:assets';
import Grid from '../components/Grid.astro';
import GrafikLive from '../components/live/GrafikLive.astro';
import GrafikMobileLive from '../components/live/GrafikMobileLive.astro';
import { demoProduct } from '../data/demo';
import '../styles/sections/product.css';
---

<section
  id="produkt"
  class="section product theme-dark"
  data-nav-theme="dark"
  aria-labelledby="product-title"
>
  <Grid />

  <div class="container">
    <!-- TODO(treść): DEMO, fikcyjny produkt z src/data/demo.ts; docelowo D3 (nagrania PRODUCT-*) -->
    <h2 id="product-title" class="section__title t-h2" data-split="words">
      {demoProduct.name}
    </h2>
    <p class="product__lead t-lead muted">{demoProduct.lead}</p>

    <!-- Na zrzutach gra żywa warstwa grafiku (components/live/Grafik*Live, modules/product-live.ts) -->
    <div class="product__devices" data-module="product-live">
      <div class="product__laptop" data-reveal>
        <div class="product__screen" data-reveal-zoom>
          <Image
            src={demoProduct.desktop.image}
            alt={demoProduct.desktop.alt}
            widths={[960, 1440, 2048, 2880]}
            sizes="(min-width: 992px) 80vw, 100vw"
          />
          <GrafikLive uid="product" />
        </div>
      </div>
      <div class="product__phone" data-reveal>
        <div class="product__screen" data-reveal-zoom>
          <Image
            src={demoProduct.mobile.image}
            alt={demoProduct.mobile.alt}
            widths={[390, 780]}
            sizes="(min-width: 992px) 25vw, 50vw"
          />
          <GrafikMobileLive />
        </div>
      </div>
    </div>
  </div>
</section>
