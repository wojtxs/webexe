---
/**
 * 07 Kontakt / stopka — greybox (F3). Krótki formularz (D7) + bezpośredni kontakt,
 * ostatni węzeł x w gradiencie stoi nad CTA, wielki wordmark (D8) na dole
 * (docs/INSPIRACJE.md, wiersz Kontakt).
 * Ruch (modules/contact.ts): litery wordmarku spod maski, drgnięcie pustego pola, stan sukcesu (DEMO).
 */
import Button from '../components/Button.astro';
import Grid from '../components/Grid.astro';
import Wordmark from '../components/Wordmark.astro';
import XMark from '../components/XMark.astro';
import { demoContact } from '../data/demo';
import '../styles/sections/contact.css';
---

<section
  id="kontakt"
  class="section contact theme-dark"
  data-nav-theme="dark"
  aria-labelledby="contact-title"
  data-module="contact"
>
  <Grid activeNode={0} />

  <div class="container contact__inner">
    <!-- TODO(treść): D9, brzmienie CTA (propozycja z BRIEF) -->
    <h2 id="contact-title" class="contact__title t-h1" data-split="words">
      Porozmawiajmy o projekcie
    </h2>

    <!-- TODO(treść): DEMO, przykładowy kontakt z src/data/demo.ts; docelowo D7 -->
    <div class="contact__direct">
      <p class="t-label muted">{demoContact.label}</p>
      <a class="contact__link link t-lead" href={`mailto:${demoContact.email}`}>
        {demoContact.email}
      </a>
      <a class="contact__link link t-lead" href={`tel:${demoContact.phone.replaceAll(' ', '')}`}>
        {demoContact.phone}
      </a>
    </div>

    <!-- TODO(treść): D7, obsługa wysyłki (nasz serwer pocztowy albo mailto) -->
    <form class="contact__form" novalidate data-contact="form">
      <label class="contact__field">
        <span class="t-label">{demoContact.fieldLabel}</span>
        <input class="contact__input" type="text" name="kontakt" autocomplete="email" />
      </label>
      <label class="contact__field">
        <span class="t-label">{demoContact.messageLabel}</span>
        <textarea class="contact__input contact__textarea" name="wiadomosc" rows="4"></textarea>
      </label>
      <label class="contact__consent t-small">
        <input type="checkbox" name="zgoda" />
        <span>
          {demoContact.consent}{' '}
          <a class="link" href="/polityka-prywatnosci">
            polityce prywatności
          </a>
          .
        </span>
      </label>
      <Button type="submit" class="contact__submit">
        {demoContact.submit}
      </Button>
    </form>

    <!-- TODO(treść): DEMO, stan po wysłaniu; docelowo potwierdzenie z obsługi wysyłki (D7) -->
    <div class="contact__success" role="status" data-contact="success" hidden>
      <XMark class="contact__success-x" active draw />
      <p class="t-h3" tabindex="-1" data-contact-rise>
        {demoContact.successTitle}
      </p>
      <p class="muted" data-contact-rise>
        {demoContact.successText}
      </p>
    </div>
  </div>

  <footer class="container contact__footer">
    <Wordmark class="contact__wordmark" split />
    <a class="contact__legal link t-small" href="/polityka-prywatnosci">
      Polityka prywatności
    </a>
  </footer>
</section>
