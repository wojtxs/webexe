---
/**
 * 03 Realizacje i dowody — greybox (F3). Cała treść zależy od D3 (min. 4 projekty).
 * Duże karty na kolumnach siatki ze staggerem (docs/INSPIRACJE.md, wiersz Realizacje).
 * Dowody jak „Achievements” u Chipsy: logotypy w komórkach siatki stoją (sticky), a karta z liczbami
 * wjeżdża na nie od dołu i wtedy ruszają liczniki (modules/proof.ts, odometer.ts).
 */
import { Image } from 'astro:assets';
import Grid from '../components/Grid.astro';
import FakturyLive from '../components/live/FakturyLive.astro';
import FlotaLive from '../components/live/FlotaLive.astro';
import PrzeplywyLive from '../components/live/PrzeplywyLive.astro';
import SerwisLive from '../components/live/SerwisLive.astro';
import { demoClients, demoNumbers, demoProjects } from '../data/demo';
import '../styles/sections/work.css';
---

<section
  id="realizacje"
  class="section work theme-dark"
  data-nav-theme="dark"
  aria-labelledby="work-title"
>
  <Grid />

  <div class="container" data-module="work-live">
    <!-- TODO(treść): nagłówek sekcji, roboczo nazwa z mapy w BRIEF -->
    <h2 id="work-title" class="section__title t-h2" data-split="words">
      Realizacje
    </h2>

    <ol class="work__list" data-module="squeeze">
      <!-- TODO(treść): DEMO, fikcyjne projekty z src/data/demo.ts; docelowo D3 (obraz + pętla wideo).
           Zamiast wideo gra żywa warstwa nad zrzutem (components/live/*, modules/work-live.ts). -->
      {demoProjects.map((project) => (
        <li class="work__item">
          <article class="work-card">
            <div
              class="work-card__media"
              data-live-card
              data-cursor="Podgląd na żywo"
              data-tilt="3"
              data-reveal
            >
              <div class="work-card__shot" data-reveal-zoom>
                <div class="work-card__frame">
                  <Image
                    src={project.image}
                    alt={project.alt}
                    widths={[640, 1024, 1440, 2048]}
                    sizes="(min-width: 992px) 75vw, 100vw"
                  />
                  {project.live === 'flota' && <FlotaLive uid="work-flota" />}
                  {project.live === 'faktury' && <FakturyLive uid="work-faktury" />}
                  {project.live === 'przeplywy' && <PrzeplywyLive />}
                  {project.live === 'serwis' && <SerwisLive uid="work-serwis" />}
                </div>
                <div class="work-card__toner"></div>
              </div>
            </div>
            <p class="work-card__tags t-label muted">{project.tags}</p>
            <h3 class="work-card__title t-h3">{project.title}</h3>
            <p class="work-card__desc muted">{project.desc}</p>
          </article>
        </li>
      ))}
    </ol>

    <!-- TODO(treść): DEMO, zmyślone liczby i klienci z src/data/demo.ts; docelowo D3 -->
    <div class="proof" data-module="proof odometer">
      <ul class="proof__clients" aria-label="Klienci">
        {demoClients.map((client) => (
          <li class="proof__cell">
            <span class="proof__client">{client}</span>
          </li>
        ))}
      </ul>

      <div class="proof__card">
        <ul class="proof__numbers" aria-label="Liczby">
          {demoNumbers.map((item) => (
            <li class="proof__number">
              <span class="proof__value t-h1" data-odometer>
                {item.value}
              </span>
              <span class="t-small muted">{item.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
