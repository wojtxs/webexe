---
/**
 * 03 Realizacje (docs/sections/03-realizacje.md, widok A). Treść zależy od D3, do tego czasu DEMO.
 * Trzy wyróżnione realizacje z kolekcji (data/realizacje.ts) jako duże karty na kolumnach siatki
 * ze staggerem (docs/INSPIRACJE.md, wiersz Realizacje), wiersz-link do /realizacje, a na końcu
 * technologie, na których budujemy: ikona i nazwa w komórkach widocznej siatki.
 */
import Grid from '../components/Grid.astro';
import WorkCard from '../components/WorkCard.astro';
import { demoStack } from '../data/demo';
import { featuredOf, getRealizacje } from '../data/realizacje';
import { tech } from '../data/tech';
import '../styles/sections/work.css';

const all = await getRealizacje();
const featured = featuredOf(all);
---

<section
  id="realizacje"
  class="section work theme-dark"
  data-nav-theme="dark"
  aria-labelledby="work-title"
>
  <Grid />

  <div class="container" data-module="work-live">
    <!-- TODO(treść): nagłówek sekcji, roboczo nazwa z mapy w BRIEF -->
    <h2 id="work-title" class="section__title t-h2" data-split="words">
      Realizacje
    </h2>

    <ol class="work__list" data-module="squeeze">
      {featured.map((entry) => (
        <li class="work__item">
          <WorkCard entry={entry} sizes="(min-width: 992px) 75vw, 100vw" />
        </li>
      ))}
    </ol>

    <!-- TODO(treść): etykieta wiersza; liczba to liczba wpisów w kolekcji -->
    <a class="work__all" href="/realizacje/">
      <span class="work__all-surface" aria-hidden="true"></span>
      <span class="t-h2">Wszystkie realizacje</span>
      <span class="work__all-count t-label" aria-hidden="true">
        {all.length}
      </span>
    </a>

    <!-- TODO(treść): DEMO, lista technologii z src/data/demo.ts do potwierdzenia; nagłówek roboczy -->
    <div class="stack">
      <h3 id="stack-title" class="stack__title t-label muted">
        Technologie, na których budujemy
      </h3>
      <ul class="stack__list" aria-labelledby="stack-title">
        {demoStack.map((key) => {
          const { name, icon: Icon } = tech[key];
          return (
            <li class="stack__cell">
              <Icon class="stack__icon" aria-hidden="true" focusable="false" />
              <span class="t-small">{name}</span>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>
