---
/**
 * 01 Hero — „Schemat systemu” (docs/sections/01-hero.md).
 *
 * Wielki nagłówek w dwóch wierszach (drugi od linii siatki kolumny 4), lead wsunięty obok drugiego
 * wiersza, pod nim CTA. Niżej schemat: szyna danych z węzłami x i cztery moduły na kolumnach siatki,
 * czyli fragmenty prawdziwych aplikacji, po jednym na warstwę oferty (Aplikacje, Integracje,
 * Automatyzacje, Utrzymanie). Aktywny moduł ma 6 kolumn, pozostałe po 2. Hierarchię zmienia
 * kursor, fokus, dotknięcie albo pokaz co kilka sekund; impuls na szynie przenosi ją z modułu
 * do modułu (hero-system). Klik w aktywny moduł prowadzi do realizacji.
 * Bez JS i przy reduced motion: pierwszy moduł aktywny, przełączanie bez ruchu.
 */
import Button from '../components/Button.astro';
import CaseShot from '../components/CaseShot.astro';
import Grid from '../components/Grid.astro';
import XMark from '../components/XMark.astro';
import { caseHref, getRealizacje, morphName } from '../data/realizacje';
import { layers } from '../data/layers';
import { noOrphans } from '../data/typo';
import '../styles/sections/hero.css';

const all = await getRealizacje();
const byLive = (live: string) => all.find((entry) => entry.data.live === live)!;

// Warstwa oferty → fragment realizacji. fx, fy: punkt kadru (ułamki zrzutu), który stoi
// na środku modułu; moduł przy rozszerzaniu odsłania kadr wokół niego.
// Integracje i Utrzymanie to dwa fragmenty jednej realizacji (tagi: Integracje × Utrzymanie):
// mapa połączeń i monitoring przepływów.
const modules = [
  { layer: layers[0], entry: byLive('flota'), fx: 0.44, fy: 0.6 },
  { layer: layers[1], entry: byLive('przeplywy'), fx: 0.43, fy: 0.38 },
  { layer: layers[2], entry: byLive('faktury'), fx: 0.58, fy: 0.44 },
  { layer: layers[3], entry: byLive('przeplywy'), fx: 0.86, fy: 0.76, zoom: 2 },
];
const WIDE = 6;
const NARROW = 2;
---

<section
  id="hero"
  class="hs theme-light"
  data-nav-theme="light"
  data-module="hero-system"
  aria-labelledby="hero-title"
>
  <Grid nodes={false} />
  <!-- Tło: sieć węzłów x, pakiety danych do aktywnego modułu, węzły za kursorem (hero-field) -->
  <canvas class="hs__field" aria-hidden="true" data-module="hero-field"></canvas>

  <div class="container hs__head">
    <h1 id="hero-title" class="hs__title">
      <span class="hs__title-in" data-split="words" data-split-intro>
        <span class="hs__line">Budujemy systemy,</span>
        <span class="hs__line hs__line--2">
          które zostają<span class="hs__stop">.</span>
        </span>
      </span>
    </h1>

    <p class="hs__lead" data-intro>
      {noOrphans(
        'Tworzymy aplikacje do codziennej pracy, łączymy istniejące systemy i automatyzujemy powtarzalne zadania.'
      )}
    </p>

    <!-- TODO(treść): „Zobacz realizacje” -->
    <!-- CTA kontaktu stoi tylko w pasku (użytkownik 2026-11-03: z hero do wyrzucenia) -->
    <div class="hs__actions" data-intro>
      <Button href="#realizacje" variant="ghost">
        Zobacz realizacje
      </Button>
    </div>
  </div>

  <div class="container hs__system">
    <!-- TODO(treść): etykiety pauzy, kursora i opis listy dla czytnika -->
    <button
      class="hs__pause"
      type="button"
      aria-pressed="false"
      aria-label="Zatrzymaj pokaz realizacji"
      data-hs-pause
    >
      <span class="hs__pause-icon" aria-hidden="true"></span>
    </button>

    <!-- Szyna danych nad modułami: węzeł x na granicy każdego modułu, impuls niesie aktywność -->
    <span class="hs__bus" aria-hidden="true" data-hs-bus></span>
    <span class="hs__pulse" aria-hidden="true" data-hs-pulse></span>

    <ul class="hs__strip" aria-label="Warstwy oferty w naszych realizacjach" data-hs-strip>
      {modules.map(({ layer, entry, fx, fy, zoom }, k) => (
        <li
          class:list={['hs__seg', { 'is-active': k === 0 }]}
          style={`--w: ${k === 0 ? WIDE : NARROW}; --fx: ${fx}; --fy: ${fy}${zoom ? `; --zoom: ${zoom}` : ''}`}
          data-hs-seg
        >
          <p class="hs__label" aria-hidden="true">
            <XMark class="hs__node" active={k === 0} draw />
            <span class="hs__label-in" data-hs-label>
              <span class="hs__layer">{layer}</span>
              <span class="hs__name">{entry.data.title}</span>
            </span>
          </p>
          <a
            class="hs__panel"
            href={caseHref(entry)}
            aria-label={`${layer}: ${entry.data.title}`}
            data-cursor="Zobacz realizację"
            data-morph={morphName(entry)}
            data-morph-source={morphName(entry)}
            data-hs-panel
          >
            <div class="shot hs__canvas" data-hs-canvas>
              <CaseShot
                image={entry.data.cover}
                alt=""
                live={entry.data.live}
                uid={`hero-${k}`}
                sizes="(max-width: 991px) 220vw, 80vw"
                eager
              />
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
