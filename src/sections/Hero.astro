---
/**
 * 01 Hero — greybox (F3). Karta z nagraniem projektu rozszerza się na sticky torze
 * od okna w prawym dolnym rogu do pełnego kontenera (docs/INSPIRACJE.md, wiersz Hero).
 * Docelowy spec: docs/sections/01-hero.md (F2). Materiał karty: D3.
 */
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
import Grid from '../components/Grid.astro';
import FlotaLive from '../components/live/FlotaLive.astro';
import { demoHero } from '../data/demo';
import '../styles/sections/hero.css';

const layers = ['Aplikacje', 'Integracje', 'Automatyzacje', 'Utrzymanie'];
---

<section
  id="hero"
  class="hero theme-light sticky-track"
  data-nav-theme="light"
  data-module="card-expand"
  aria-labelledby="hero-title"
>
  <Grid nodes={false} />

  <div class="sticky-item hero__stage">
    <div class="container hero__inner">
      <div class="hero__copy" data-card-expand="fade">
        <h1 id="hero-title" class="hero__title t-h1" data-split="words" data-split-intro>
          Budujemy <br class="br-d" />
          oprogramowanie <br class="br-d" />
          dla firm i zostajemy <br class="br-d" />
          przy nim na lata.
        </h1>
        <p class="hero__lead t-lead" data-intro>
          Aplikacje webowe, systemy wewnętrzne, integracje i automatyzacje z AI. Projektujemy je
          razem z wami, wdrażamy etapami i utrzymujemy na własnej infrastrukturze.
        </p>
        <!-- TODO(treść): D9, brzmienie CTA (propozycja z BRIEF) -->
        <Button href="#kontakt" class="hero__cta" data-intro>
          Porozmawiajmy o projekcie
        </Button>
      </div>

      <div class="hero__window" data-card-expand="window" aria-hidden="true"></div>

      <figure
        class="hero__card"
        data-card-expand="card"
        data-module="hero-live"
        data-intro="fade"
        data-tilt="6"
        data-tilt-area="[data-card-expand=window]"
      >
        <!-- TODO(treść): DEMO, zrzut fikcyjnego projektu z src/data/demo.ts; docelowo nagranie (D3, HERO-MEDIA) -->
        <Image
          class="hero__media"
          src={demoHero.image}
          alt=""
          widths={[960, 1440, 1920, 2880]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          data-loader-wait
        />
        <FlotaLive uid="hero" feed />
        <figcaption class="sr-only">{demoHero.alt}</figcaption>
        <ul class="hero__layers" aria-label="Warstwy systemu">
          {layers.map((layer) => (
            <li class="hero__layer t-label">{layer}</li>
          ))}
        </ul>
      </figure>
    </div>
  </div>
</section>
