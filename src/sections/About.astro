---
/**
 * 06 Poznaj nas — greybox (F3). Tekst z wersji 1 (D10), dwa zdjęcia founderów (D4)
 * na kolumnach siatki ze staggerem (docs/INSPIRACJE.md, Struktura).
 */
import Grid from '../components/Grid.astro';
import '../styles/sections/about.css';
---

<section
  id="poznaj-nas"
  class="section about theme-light"
  data-nav-theme="light"
  aria-labelledby="about-title"
>
  <Grid />

  <div class="container about__inner">
    <h2 id="about-title" class="section__title t-h2" data-split="words">
      Poznaj nas
    </h2>

    <!-- TODO(treść): D10, tekst z wersji 1 do przepisania na formę „wy” i nowy ton -->
    <p class="about__text t-lead">
      Jesteśmy dwuosobowym zespołem programistycznym specjalizującym się w tworzeniu aplikacji i
      automatyzacji procesów biznesowych. Stawiamy na bezpośrednią współpracę, przemyślane
      rozwiązania i praktyczne wykorzystanie technologii. Naszym celem jest dostarczanie
      oprogramowania, które nie tylko dobrze działa, ale przede wszystkim wnosi rzeczywistą wartość
      do działalności klienta.
    </p>

    <div class="about__photo about__photo--a ph">TODO(treść): zdjęcie foundera (D4, TEAM-1)</div>
    <div class="about__photo about__photo--b ph">TODO(treść): zdjęcie foundera (D4, TEAM-2)</div>
  </div>
</section>
