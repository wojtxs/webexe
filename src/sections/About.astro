---
/**
 * 06 Poznaj nas — greybox (F3). Tekst z BRIEF (06), dwa zdjęcia founderów (D4)
 * na kolumnach siatki ze staggerem (docs/INSPIRACJE.md, Struktura).
 * Ruch (modules/about.ts): zdania podświetlane scrollem, zdjęcia wylatują ze stosu na kolumny.
 */
import Grid from '../components/Grid.astro';
import '../styles/sections/about.css';
---

<section
  id="poznaj-nas"
  class="section about theme-light"
  data-nav-theme="light"
  aria-labelledby="about-title"
>
  <Grid />

  <div class="container about__inner" data-module="about">
    <h2 id="about-title" class="section__title t-h2" data-split="words">
      Poznaj nas
    </h2>

    <p class="about__text t-lead" data-about="text">
      Jesteśmy dwuosobowym zespołem programistycznym. Tworzymy aplikacje webowe, integracje i
      automatyzacje dla firm. Pracujemy bezpośrednio z klientami, od pierwszych ustaleń po wdrożenie
      i późniejsze utrzymanie. Lubimy projekty, w których można uporządkować skomplikowany proces,
      zastąpić kilka niepołączonych narzędzi jednym rozwiązaniem albo pozbyć się pracy wykonywanej
      codziennie ręcznie. Sami piszemy i utrzymujemy oprogramowanie, które dostarczamy. Dzięki temu
      znamy te systemy również po zakończeniu pierwszego etapu projektu.
    </p>

    <div class="about__photo about__photo--a ph" data-about="photo">
      TODO(treść): zdjęcie foundera (D4, TEAM-1)
    </div>
    <div class="about__photo about__photo--b ph" data-about="photo">
      TODO(treść): zdjęcie foundera (D4, TEAM-2)
    </div>
  </div>
</section>
