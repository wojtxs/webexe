---
/**
 * WorkCard — karta realizacji (sekcja 03 na głównej i lista /realizacje).
 * Dwa linki do tej samej strony projektu: kadr (myszą, poza tabulatorem i czytnikiem, bo powtarza
 * tytuł) i tytuł (jedyny przystanek tabulatora, nazwa linku = tytuł). Focus ring tytułu obrysowuje
 * kadr (components.css). Kadr gra pod kursorem (work-live), przechyla się (tilt) i ściska przy
 * szybkim scrollu (squeeze na liście).
 */
import { caseHref, type Realizacja } from '../data/realizacje';
import CaseShot from './CaseShot.astro';
import Tags from './Tags.astro';

interface Props {
  entry: Realizacja;
  sizes: string;
  /** Poziom tytułu: h3 pod nagłówkiem sekcji na głównej, h2 pod h1 listy */
  heading?: 'h2' | 'h3';
}

const { entry, sizes, heading: Heading = 'h3' } = Astro.props;
const { data } = entry;
const href = caseHref(entry);
---

<article class="work-card">
  <!-- TODO(treść): etykieta kursora -->
  <a
    class="shot work-card__media"
    href={href}
    tabindex="-1"
    aria-hidden="true"
    data-live-card
    data-cursor="Zobacz realizację"
    data-tilt="3"
    data-reveal
  >
    <CaseShot
      image={data.cover}
      alt={data.coverAlt}
      live={data.live}
      uid={`card-${entry.id}`}
      sizes={sizes}
    />
  </a>
  <Tags tags={data.tags} class="work-card__tags muted" />
  <Heading class="work-card__title t-h3">
    <a class="work-card__link" href={href}>
      {data.title}
    </a>
  </Heading>
  <p class="work-card__desc muted">{data.summary}</p>
</article>
