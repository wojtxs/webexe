---
/**
 * Button — link albo przycisk. Wariant cta: gradient Laguna, tekst w Głębi (docs/DESIGN.md, Kolory).
 * Wariant ghost: obrys i tekst w kolorze rogu (przycisk menu).
 * Hover „roll” na znakach (DESIGN.md, Ruch): tekst z treści rozbity na słowa i znaki, każdy znak
 * ze swoim --i do stopniowania w CSS. Czytniki dostają cały tekst z .sr-only, znaki są aria-hidden.
 * Treść z HTML-em zostaje bez rozbicia; ikonę obok tekstu z rollem podaje slot "icon".
 */
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'cta' | 'ghost';
  class?: string;
  hidden?: boolean;
  /** Haki dla modułów (np. data-intro) */
  [key: `data-${string}`]: string | boolean | undefined;
  [key: `aria-${string}`]: string | boolean | undefined;
}

const { href, type = 'button', variant = 'cta', class: className, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, className];
const Tag = href ? 'a' : 'button';
const attrs = href ? { href } : { type };

const html = Astro.slots.has('default') ? await Astro.slots.render('default') : '';
const text = html.replace(/\s+/g, ' ').trim();
const plain = text !== '' && !/[<&]/.test(text);
let index = 0;
const words = plain
  ? text.split(' ').map((word) => Array.from(word).map((char) => ({ char, i: index++ })))
  : [];
---

<Tag class:list={classes} {...attrs} {...rest}>
  {plain ? (
    <>
      <span class="btn__roll" aria-hidden="true">
        {words.map((word, w) => (
          <>
            {w > 0 && ' '}
            <span class="btn__word">
              {word.map(({ char, i }) => (
                <span class="btn__char" style={`--i: ${i}`}>
                  {char}
                </span>
              ))}
            </span>
          </>
        ))}
      </span>
      <span class="sr-only">{text}</span>
    </>
  ) : (
    <Fragment set:html={html} />
  )}
  <slot name="icon" />
</Tag>
