---
/**
 * Corners — stałe elementy w rogach ekranu (docs/INSPIRACJE.md, wiersz Nawigacja):
 * wordmark w lewym górnym, stałe CTA i przycisk menu w prawym górnym, mapa rozdziałów w lewym dolnym.
 * Punkty mapy to znaki x. Mapa jest zwinięta do bieżącego rozdziału, którego x rysuje się
 * gradientem razem z postępem sekcji (motyw, DESIGN.md); hover albo focus rozwija całą listę.
 * Menu wyrasta z przycisku (na mobile pełny ekran z CTA na dole); przycisk pokazuje dopiero moduł menu,
 * bez JS zostają kotwice mapy i CTA.
 * Kolory rogów zmienia nav-theme według [data-nav-theme] pod rogiem; mapę prowadzi chapter-map.
 */
import { demoContact } from '../data/demo';
import Button from './Button.astro';
import Wordmark from './Wordmark.astro';
import XMark from './XMark.astro';

// TODO(treść): etykiety rozdziałów; roboczo nazwy z mapy w BRIEF, „Start” dla hero
const chapters = [
  { id: 'hero', label: 'Start' },
  { id: 'manifest', label: 'Manifest' },
  { id: 'realizacje', label: 'Realizacje' },
  { id: 'produkt', label: 'Produkt' },
  { id: 'jak-pracujemy', label: 'Jak pracujemy' },
  { id: 'poznaj-nas', label: 'Poznaj nas' },
  { id: 'kontakt', label: 'Kontakt' },
];
---

<header class="corners" data-module="nav-theme menu">
  <a class="corners__brand" href="#hero" aria-label="webexe, początek strony" data-intro>
    <Wordmark />
  </a>

  <div class="corners__actions">
    <!-- TODO(treść): D9, brzmienie CTA (propozycja z BRIEF) -->
    <Button href="#kontakt" class="corners__cta" data-intro>
      Porozmawiajmy o projekcie
    </Button>

    <Button
      variant="ghost"
      class="corners__menu"
      aria-expanded="false"
      aria-controls="menu"
      data-menu-toggle
      data-intro
      hidden
    >
      Menu
    </Button>
  </div>

  <div class="menu" id="menu" data-menu-panel inert>
    <nav class="menu__nav" aria-label="Menu">
      <ul class="menu__list">
        {chapters.map((chapter) => (
          <li data-menu-item>
            <a class="menu__link t-h3" href={`#${chapter.id}`}>
              <XMark class="menu__x" />
              {chapter.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- TODO(treść): DEMO, przykładowy kontakt z src/data/demo.ts; docelowo D7 -->
    <div class="menu__contact" data-menu-item>
      <a class="link" href={`mailto:${demoContact.email}`}>
        {demoContact.email}
      </a>
      <a class="link" href={`tel:${demoContact.phone.replaceAll(' ', '')}`}>
        {demoContact.phone}
      </a>
    </div>

    <!-- TODO(treść): D9, brzmienie CTA (propozycja z BRIEF) -->
    <Button href="#kontakt" class="menu__cta" data-menu-item>
      Porozmawiajmy o projekcie
    </Button>
  </div>

  <nav class="chapters" aria-label="Rozdziały strony" data-module="chapter-map" data-intro>
    <ol class="chapters__list">
      {chapters.map((chapter) => (
        <li>
          <a class="chapters__link" href={`#${chapter.id}`} data-chapter={chapter.id}>
            <span class="chapters__mark">
              <XMark class="chapters__x" />
              <XMark class="chapters__x chapters__x--progress" draw />
            </span>
            <span class="chapters__label t-label">{chapter.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</header>
