---
/**
 * Loader (00) — znak x rysuje się dwiema kreskami na Głębi, pod nim spod maski wjeżdżają
 * wordmark i wiersz warstw, potem wiersze zjeżdżają w maskę, panel zjeżdża w górę i wchodzi hero
 * (docs/BRIEF.md, mapa strony; limit 2,5 s z docs/ARCHITECTURE.md, Ładowanie).
 * Kreski i wiersze rysuje CSS od pierwszej klatki, bez czekania na JS. Wyjście i wejście hero:
 * modules/loader.ts. Widoczny tylko przy html.js-motion (Base.astro): reduced motion go nie
 * pokazuje, a gdy JS zawiedzie, znika z klasą po 3 s.
 * Placeholder x do czasu wordmarku SVG (D8): docelowo ten sam x co w wordmarku.
 */
import { layers } from '../data/layers';
import Wordmark from './Wordmark.astro';
import XMark from './XMark.astro';
---

<div class="loader" aria-hidden="true" data-module="loader">
  <div class="loader__stack">
    <svg class="loader__x" viewBox="0 0 24 24" focusable="false">
      <path d="M6 6 18 18" pathLength="1"></path>
      <path d="M18 6 6 18" pathLength="1"></path>
    </svg>
    <span class="loader__row">
      <span class="loader__line" data-loader-line>
        <Wordmark class="loader__wordmark" />
      </span>
    </span>
    <span class="loader__row t-label">
      <span class="loader__line" data-loader-line>
        {layers.map((layer, i) => (
          <span class="loader__item">
            {i > 0 && <XMark class="loader__sep" />}
            {layer}
          </span>
        ))}
      </span>
    </span>
  </div>
</div>
