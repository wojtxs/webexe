---
/**
 * FlotaLive — żywa warstwa nad zrzutem kokpitu floty (eksperyment, DEMO): trasy, pojazdy, paski postępu.
 * SVG ma viewBox zrzutu (1440 × 900) i preserveAspectRatio slice, czyli ten sam kadr co
 * object-fit: cover obrazu, więc trasy leżą dokładnie na mapie przy każdym kadrze.
 * Stan początkowy (postęp t0) jest w HTML: bez JS i przy reduced motion wygląda jak pełny zrzut.
 * Z feed dochodzi kanał powiadomień nad mapą (tylko hero): sprite'y po jednym na etykietę warstwy,
 * w spoczynku ukryte. Geometria: assets-src/demo/render.mjs → src/data/live/flota.json.
 * Ruch: modules/live/flota.ts, kanał: modules/hero-live.ts.
 */
import toastApp from '../../assets/demo/flota-toast-app.webp';
import toastAuto from '../../assets/demo/flota-toast-auto.webp';
import toastInt from '../../assets/demo/flota-toast-int.webp';
import toastOps from '../../assets/demo/flota-toast-ops.webp';
import geom from '../../data/live/flota.json';
import { pathD, pointAt, polyline, type Point } from '../../core/polyline';
import '../../styles/live.css';

interface Props {
  /** Prefiks identyfikatorów gradientów, unikalny na stronie */
  uid: string;
  /** Kanał powiadomień (w kolejności etykiet warstw hero) */
  feed?: boolean;
}

const { uid, feed = false } = Astro.props;
const s = geom.scale;
const routes = geom.routes.map((route) => {
  const [x, y] = pointAt(polyline(route.points as Point[]), route.t0);
  return { ...route, d: pathD(route.points as Point[]), x, y };
});
const toasts = [
  { src: toastApp.src, ...geom.sprites['flota-toast-app'] },
  { src: toastInt.src, ...geom.sprites['flota-toast-int'] },
  { src: toastAuto.src, ...geom.sprites['flota-toast-auto'] },
  { src: toastOps.src, ...geom.sprites['flota-toast-ops'] },
];
const bars = geom.bars.map((bar) => ({
  ...bar,
  t0: routes.find((route) => route.id === bar.id)?.t0 ?? 0,
}));
---

<svg
  class="live"
  viewBox={`0 0 ${geom.width} ${geom.height}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  data-live="flota"
>
  <defs>
    <linearGradient id={`${uid}-bar`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" class="live__stop-start"></stop>
      <stop offset="1" class="live__stop-end"></stop>
    </linearGradient>
  </defs>

  {bars.map((bar) => (
    <rect
      data-live-bar={bar.id}
      x={bar.x}
      y={bar.y}
      width={bar.w * bar.t0}
      height={bar.h}
      rx={bar.h / 2}
      fill={`url(#${uid}-bar)`}
    />
  ))}

  {routes.map((route) => (
    <g class={`live--${route.color}`} data-live-route={route.id}>
      <path
        class="live-flota__trail"
        d={route.d}
        pathLength="1"
        stroke-dasharray={`${route.t0} 1`}
        stroke-width={2.4 * s}
      />
      <circle class="live-flota__glow" cx={route.x} cy={route.y} r={9 * s} />
      {route.sel && (
        <circle
          class="live-flota__pulse"
          cx={route.x}
          cy={route.y}
          r={6 * s}
          stroke-width={1.5 * s}
        />
      )}
      <circle
        class="live-flota__car"
        cx={route.x}
        cy={route.y}
        r={(route.sel ? 6 : 4.5) * s}
        stroke-width={2.4 * s}
      />
      {route.sel && (
        <g class="live-flota__tip" transform={`translate(${route.x} ${route.y})`}>
          <rect x={12 * s} y={-30 * s} width={118 * s} height={40 * s} rx={7 * s} />
          <text class="live-flota__tip-title" x={22 * s} y={-14 * s} font-size={12 * s}>
            WZ 4821K
          </text>
          <text x={22 * s} y={1 * s} font-size={11 * s}>
            78 km/h · ETA 16:20
          </text>
        </g>
      )}
    </g>
  ))}

  {feed &&
    toasts.map((toast) => (
      <image
        class="live-flota__toast"
        data-live-toast
        href={toast.src}
        x={toast.x}
        y={toast.y}
        width={toast.w}
        height={toast.h}
      />
    ))}
</svg>
