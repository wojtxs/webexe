---
import type { HTMLAttributes } from 'astro/types';

// Preload via Vite ?url — hashed paths gwarantują długi cache
import pjsNormalUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import pjsLatinExtUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-ext-wght-normal.woff2?url';

// Styles
import '../styles/fonts.css';
import '../styles/fluid.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utils.css';
import '../styles/components.css';
import Cursor from '../components/Cursor.astro';
import Curtain from '../components/Curtain.astro';

interface Props extends HTMLAttributes<'html'> {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = 'webexe — oprogramowanie dla firm',
  description = 'Budujemy oprogramowanie dla firm i zostajemy przy nim na lata. Aplikacje webowe, systemy wewnętrzne, integracje i automatyzacje z AI.',
  ogImage,
  noindex = false,
  ...rest
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pl" {...rest}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Preload krytycznych fontów (body text) -->
    <link rel="preload" href={pjsNormalUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={pjsLatinExtUrl} as="font" type="font/woff2" crossorigin />

    <!-- Ukrycie nagłówków do czasu reveal'u słów (split-reveal); fallback po 3 s, bez ruchu nic nie ukrywa -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-motion');
        setTimeout(() => document.documentElement.classList.remove('js-motion'), 3000);
      }
    </script>

    <!-- Kurtyna przejścia (modules/curtain.ts): po kliknięciu w link do innej strony zakrywa nową
         od pierwszej klatki; fallback po 3 s, bez ruchu nic nie zakrywa -->
    <script is:inline>
      try {
        if (
          sessionStorage.getItem('wxe-curtain') &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          document.documentElement.classList.add('curtain-in');
          setTimeout(() => document.documentElement.classList.remove('curtain-in'), 3000);
        }
      } catch {
        // Bez sessionStorage strona po prostu nie ma kurtyny
      }
    </script>

    <slot name="head" />
  </head>
  <body>
    <!-- Skip to content (a11y) -->
    <a
      href="#main-content"
      class="sr-only"
      style="position:absolute;top:var(--s-4);left:var(--s-4);z-index:9999;background:var(--c-biel);color:var(--c-glebia);padding:var(--s-2) var(--s-4);border-radius:var(--r-chip);"
    >
      Przejdź do treści
    </a>

    <!-- Gradient Laguna dla znaku x (XMark active, wordmark), 135° jak --g-laguna -->
    <svg class="sr-only" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="x-laguna" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" class="x-laguna-start"></stop>
          <stop offset="1" class="x-laguna-end"></stop>
        </linearGradient>
      </defs>
    </svg>

    <!-- Stałe elementy w rogach ekranu (strona główna) -->
    <slot name="chrome" />

    <!-- Pierścień za kursorem (tylko precyzyjny kursor i pełny ruch) -->
    <Cursor />

    <!-- Kurtyna przejścia między stronami -->
    <Curtain />

    <!-- Treść strony -->
    <main id="main-content" data-module="split-reveal media-reveal tilt grid-draw">
      <slot />
    </main>

    <!-- Moduły JS: ładowane po treści -->
    <script>
      import '@core/app';
    </script>
  </body>
</html>
